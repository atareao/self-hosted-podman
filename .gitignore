
# environment.d: FQDN real es especifico del host (no se versiona)
.config/environment.d/fqdn.conf

# Nota: .config/vector/vector.yaml YA NO es un render; es fuente versionada
# (usa interpolacion ${VAR} nativa de Vector). Solo dashboard-auth.yml se renderiza.

# fish universal variables: especificas de cada maquina (fish las reescribe)
.config/fish/fish_variables

# overrides por-maquina de los .env de stack (se auto-crean en el hook post_pull)
.config/**/*.env.local

# relevo de sesion (local, no se despliega)
HANDOFF.md
