---
# Headscale — plantilla de configuracion. Se renderiza a config.yaml con
# unjinja/jinrender (via yadm), por eso el FQDN va como {{ env.FQDN }}.
# Detras de Traefik: headscale escucha HTTP y el TLS lo termina Traefik.

server_url: https://headscale.{{ env.FQDN }}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090

grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false

# Subred de proxy.network (Traefik). Necesario para honrar X-Forwarded-For.
trusted_proxies:
  - 10.89.0.0/24

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: "headscale"
    region_name: "Headscale Embedded DERP"
    verify_clients: true
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 3h

disable_check_updates: false

database:
  type: sqlite
  debug: false
  sqlite:
    path: /var/lib/headscale/db.sqlite

# TLS lo termina Traefik.
tls_cert_path: ""
tls_key_path: ""

policy:
  mode: file
  path: ""

dns:
  magic_dns: true
  base_domain: "tailnet.{{ env.FQDN }}"
  override_local_dns: true
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1
  search_domains: []
  extra_records: []

log:
  level: info
  format: text

unix_socket: /var/lib/headscale/headscale.sock
unix_socket_permission: "0770"
