# Config NO secreta de la stack tick (versionada).
# Overrides por maquina en tick.env.local (gitignored; lo crea el hook post_pull).
#
# Los valores de ORG/BUCKET se fijan en el primer arranque de InfluxDB
# (DOCKER_INFLUXDB_INIT_MODE=setup) y NO se pueden cambiar despues sin recrear
# el volumen tick-influxdb. Telegraf escribe en este mismo bucket/organizacion.
# Las credenciales (DOCKER_INFLUXDB_INIT_PASSWORD / DOCKER_INFLUXDB_INIT_ADMIN_TOKEN)
# NO van aqui: se inyectan con Secret=influxdb_admin_password / influxdb_admin_token.
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_ORG=atareao
DOCKER_INFLUXDB_INIT_BUCKET=telegraf
