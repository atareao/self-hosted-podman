[Unit]
Description=portainer
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/portainer/portainer-ce:alpine
ContainerName=portainer
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=portainer-data.volume:/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=portainer

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.portainer.loadbalancer.server.port=9000
Label=traefik.http.routers.portainer.rule=Host(`portainer.${FQDN}`)
Label=traefik.http.routers.portainer.entrypoints=websecure
Label=traefik.http.routers.portainer.tls.certresolver=letsencrypt
Label=traefik.http.routers.portainer.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
