[Unit]
Description=kavita
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/jvmilazz0/kavita
AutoUpdate=registry
ContainerName=kavita
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=kavita-books.volume:/books:Z
Volume=kavita-data.volume:/kavita/config:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=kavita

# ==== Secrets ====


# ==== Environment ====
Environment=TZ=Europe/Madrid

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.kavita.loadbalancer.server.port=5000
Label=traefik.http.routers.kavita.rule=Host(`kavita.${FQDN}`)
Label=traefik.http.routers.kavita.entrypoints=websecure
Label=traefik.http.routers.kavita.tls.certresolver=letsencrypt
Label=traefik.http.routers.kavita.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
