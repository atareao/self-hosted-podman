[Unit]
Description=dim
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/dusk-labs/dim:dev
ContainerName=dim
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/dim/config:/opt/dim/config:Z
Volume=dim-media.volume:/media:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=dim

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.dim.loadbalancer.server.port=8000
Label=traefik.http.routers.dim.rule=Host(`dim.{{ env.FQDN }}`)
Label=traefik.http.routers.dim.entrypoints=websecure
Label=traefik.http.routers.dim.tls.certresolver=letsencrypt
Label=traefik.http.routers.dim.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
