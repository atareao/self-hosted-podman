[Unit]
Description=dnote PostgreSQL
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:11-alpine
ContainerName=dnote-postgres
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/dnote/dnote_data:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=dnote.network
NetworkAlias=postgres

# ==== Secrets ====
Secret=dnote_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=dnote
Environment=POSTGRES_DB=dnote

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
