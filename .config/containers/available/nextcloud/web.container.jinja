[Unit]
Description=web
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/library/nginx:alpine
ContainerName=web

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/nextcloud/nextcloud:/var/www/html:ro
Volume=%h/.config/nextcloud/nginx.conf:/etc/nginx/nginx.conf:ro

# ==== Networks ====
Network=proxy.network
Network=nextcloud.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.nextcloud.loadbalancer.server.port=80
Label=traefik.http.routers.nextcloud.rule=Host(`nextcloud.{{ env.FQDN }}`)
Label=traefik.http.routers.nextcloud.entrypoints=websecure
Label=traefik.http.routers.nextcloud.tls.certresolver=letsencrypt
Label=traefik.http.routers.nextcloud.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
