[Unit]
Description=nextcloud-postgresql
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:alpine
ContainerName=nextcloud-postgresql

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/nextcloud/db:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=nextcloud.network
NetworkAlias=db

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
