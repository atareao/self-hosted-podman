[Unit]
Description=cron
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/nextcloud:fpm-alpine
ContainerName=cron

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/nextcloud/nextcloud:/var/www/html:Z

# ==== Networks ====
Network=nextcloud.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
