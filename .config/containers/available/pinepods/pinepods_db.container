[Unit]
Description=pinepods_db
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:17
ContainerName=pinepods_db
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=pinepods-pgdata.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=pinepods.network
NetworkAlias=pinepods_db

# ==== Secrets ====
Secret=pinepods_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_DB=pinepods_database
Environment=POSTGRES_USER=postgres
Environment=PGDATA=/var/lib/postgresql/data/pgdata

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
