[Unit]
Description=pinepods_valkey
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/valkey/valkey:8-alpine
ContainerName=pinepods_valkey
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=pinepods.network
NetworkAlias=pinepods_valkey

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
