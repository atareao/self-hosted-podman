[Unit]
Description=pinepods-valkey
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/valkey/valkey:8-alpine
ContainerName=pinepods-valkey
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=pinepods.network
NetworkAlias=pinepods_valkey

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=valkey-cli ping | grep PONG || exit 1
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=10s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
