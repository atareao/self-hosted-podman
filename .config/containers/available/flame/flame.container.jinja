[Unit]
Description=flame
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/pawelmalak/flame
AutoUpdate=registry
ContainerName=flame
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=flame-flame.volume:/app/data:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====
Secret=flame_password,type=env,target=PASSWORD

# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.flame.loadbalancer.server.port=5005
Label=traefik.http.routers.flame.rule=Host(`flame.{{ env.FQDN }}`)
Label=traefik.http.routers.flame.entrypoints=websecure
Label=traefik.http.routers.flame.tls.certresolver=letsencrypt
Label=traefik.http.routers.flame.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
