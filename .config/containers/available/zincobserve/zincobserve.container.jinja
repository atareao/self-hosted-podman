[Unit]
Description=zincobserve
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=public.ecr.aws/zinclabs/zincobserve:latest
AutoUpdate=registry
ContainerName=zincobserve
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=zincobserve-data.volume:/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=zincobserve

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.zincobserve.loadbalancer.server.port=5080
Label=traefik.http.routers.zincobserve.rule=Host(`zincobserve.{{ env.FQDN }}`)
Label=traefik.http.routers.zincobserve.entrypoints=websecure
Label=traefik.http.routers.zincobserve.tls.certresolver=letsencrypt
Label=traefik.http.routers.zincobserve.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
