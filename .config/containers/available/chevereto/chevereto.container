[Unit]
Description=chevereto
After=network-online.target traefik.service chevereto-mariadb.service
Requires=chevereto-mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=ghcr.io/chevereto/chevereto:latest
AutoUpdate=registry
ContainerName=chevereto
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=chevereto-data.volume:/var/www/html/images:Z

# ==== Networks ====
Network=proxy.network
Network=chevereto.network
NetworkAlias=chevereto

# ==== Secrets ====
Secret=chevereto_db_pass,type=env,target=CHEVERETO_DB_PASS

# ==== Environment ====
EnvironmentFile=%h/.config/chevereto/chevereto.env
EnvironmentFile=%h/.config/chevereto/chevereto.env.local
Environment=CHEVERETO_DB_HOST=mariadb
Environment=CHEVERETO_DB_USER=chevereto_user
Environment=CHEVERETO_DB_PORT=3306
Environment=CHEVERETO_DB_NAME=cheveretor
Environment=CHEVERETO_ASSET_STORAGE_TYPE=local
Environment=CHEVERETO_ASSET_STORAGE_URL=/images/_assets
Environment=CHEVERETO_ASSET_STORAGE_BUCKET=/var/www/html/images/_assets

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.chevereto.loadbalancer.server.port=8080
Label=traefik.http.routers.chevereto.rule=Host(`chevereto.${FQDN}`)
Label=traefik.http.routers.chevereto.entrypoints=websecure
Label=traefik.http.routers.chevereto.tls.certresolver=letsencrypt
Label=traefik.http.routers.chevereto.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
# La imagen no trae wget; usa curl. Apache sirve en 8080 (vhost *:8080).
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s


# ==== Hardening ====
# La imagen declara USER www-data, pero su Apache con módulo ssl intenta bindear
# 443 y aborta como usuario no privilegiado; como root arranca y sirve en 8080.
User=0

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
