[Unit]
Description=wger_celery_beat
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/wger/server:latest
AutoUpdate=registry
ContainerName=wger_celery_beat
PodmanArgs=--init

# ==== Command ====
Exec=/start-beat

# ==== Ports ====


# ==== Volumes ====
Volume=wger-celery-beat.volume:/home/wger/beat/:Z

# ==== Networks ====


# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
