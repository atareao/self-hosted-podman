[Unit]
Description=wger_server
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/wger/server:latest
AutoUpdate=registry
ContainerName=wger_server
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=wger-static.volume:/home/wger/static:Z
Volume=wger-media.volume:/home/wger/media:Z

# ==== Networks ====
Network=wger.network
NetworkAlias=web

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:8000 || exit 1
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
