[Unit]
Description=socks5
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/serjs/go-socks5-proxy
AutoUpdate=registry
ContainerName=socks5
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=8388:8388

# ==== Volumes ====
Volume=%h/.config/socks5/config.json:/etc/shadowsocks-rust/config.json:Z

# ==== Networks ====


# ==== Secrets ====
Secret=socks5_proxy_password,type=env,target=PROXY_PASSWORD

# ==== Environment ====
Environment=PROXY_USER=someuser
Environment=PROXY_PORT=8388

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
