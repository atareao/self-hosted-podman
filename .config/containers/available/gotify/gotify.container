[Unit]
Description=gotify
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/gotify/server:latest
AutoUpdate=registry
ContainerName=gotify

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/gotify/data:/app/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=gotify

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.gotify.loadbalancer.server.port=80
Label=traefik.http.routers.gotify.rule=Host(`gotify.${FQDN}`)
Label=traefik.http.routers.gotify.entrypoints=websecure
Label=traefik.http.routers.gotify.tls.certresolver=letsencrypt
Label=traefik.http.routers.gotify.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
