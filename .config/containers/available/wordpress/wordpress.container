[Unit]
Description=WordPress Engine
After=network-online.target wordpress-mariadb.service wordpress-valkey.service traefik.service
Requires=wordpress-mariadb.service wordpress-valkey.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/wordpress:latest
ContainerName=wordpress
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=wordpress-data.volume:/var/www/html/wp-content:Z

# ==== Networks ====
Network=wordpress.network
Network=proxy.network

# ==== Secrets ====
Secret=wordpress_db_password,type=env,target=WORDPRESS_DB_PASSWORD

# ==== Environment ====
Environment=WORDPRESS_DB_HOST=mariadb
Environment=WORDPRESS_DB_USER=wp_user
Environment=WORDPRESS_DB_NAME=wordpress
Environment="WORDPRESS_CONFIG_EXTRA=define('WP_REDIS_HOST', 'valkey'); if (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') { $_SERVER['HTTPS'] = 'on'; } define('FORCE_SSL_ADMIN', true);"

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.wordpress.loadbalancer.server.port=80
Label=traefik.http.routers.wordpress.rule=Host(`blog.${FQDN}`)
Label=traefik.http.routers.wordpress.entrypoints=websecure
Label=traefik.http.routers.wordpress.tls.certresolver=letsencrypt
Label=traefik.http.routers.wordpress.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=curl -f http://localhost/wp-login.php || exit 1
HealthInterval=10s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
ExecStartPost=/usr/bin/bash -c 'while [ "$(podman inspect --format "{{.State.Health.Status}}" wordpress)" != "healthy" ]; do sleep 2; done'

[Install]
WantedBy=default.target
