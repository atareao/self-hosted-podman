[Unit]
Description=MariaDB
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mariadb:11
ContainerName=wordpress-mariadb

# ==== Command ====
Exec=--innodb-buffer-pool-size=256M --innodb-flush-log-at-trx-commit=2

# ==== Ports ====

# ==== Volumes ====
Volume=wordpress-mariadb.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=wordpress.network
NetworkAlias=mariadb

# ==== Secrets ====
Secret=mariadb_root_password,type=env,target=MARIADB_ROOT_PASSWORD
Secret=wordpress_db_password,type=env,target=MARIADB_PASSWORD

# ==== Environment ====
Environment=MARIADB_DATABASE=wordpress
Environment=MARIADB_USER=wp_user

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=mariadb-admin ping --user=root --password="$MARIADB_ROOT_PASSWORD" --silent
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
