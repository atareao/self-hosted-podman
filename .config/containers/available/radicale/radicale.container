[Unit]
Description=radicale
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/atareao/radicale:v1.0
ContainerName=radicale

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/radicale/.htpasswd-users:/app/.htpasswd-users:Z
Volume=%h/.config/radicale/data:/app/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=radicale

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.radicale.loadbalancer.server.port=5232
Label=traefik.http.routers.radicale.rule=Host(`radicale.${FQDN}`)
Label=traefik.http.routers.radicale.entrypoints=websecure
Label=traefik.http.routers.radicale.tls.certresolver=letsencrypt
Label=traefik.http.routers.radicale.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
