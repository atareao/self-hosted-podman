[Unit]
Description=otterwiki
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/redimp/otterwiki:2
ContainerName=otterwiki
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=otterwiki-data.volume:/app-data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=otterwiki

# ==== Secrets ====


# ==== Environment ====
Environment=SITE_NAME=Wiki
Environment=DISABLE_REGISTRATION=True
Environment=READ_ACCESS=REGISTERED
Environment=WRITE_ACCESS=REGISTERED

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.otterwiki.loadbalancer.server.port=80
Label=traefik.http.routers.otterwiki.rule=Host(`wiki.${FQDN}`)
Label=traefik.http.routers.otterwiki.entrypoints=websecure
Label=traefik.http.routers.otterwiki.tls.certresolver=letsencrypt
Label=traefik.http.routers.otterwiki.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
