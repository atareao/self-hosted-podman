[Unit]
Description=gokapi
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/f0rc3/gokapi:latest
AutoUpdate=registry
ContainerName=gokapi

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=gokapi-config.volume:/app/config:Z
Volume=gokapi-data.volume:/app/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=gokapi

# ==== Secrets ====


# ==== Environment ====
EnvironmentFile=%h/.config/gokapi/gokapi.env
EnvironmentFile=%h/.config/gokapi/gokapi.env.local
Environment=GOKAPI_EXTERNAL_URL="https://gokapi.${FQDN}"

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.gokapi.loadbalancer.server.port=8080
Label=traefik.http.routers.gokapi.rule=Host(`gokapi.${FQDN}`)
Label=traefik.http.routers.gokapi.entrypoints=websecure
Label=traefik.http.routers.gokapi.tls.certresolver=letsencrypt
Label=traefik.http.routers.gokapi.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target