[Unit]
Description=phpmyadmin
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/phpmyadmin
AutoUpdate=registry
ContainerName=phpmyadmin

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
Network=phpmyadmin.network
NetworkAlias=myadmin

# ==== Secrets ====


# ==== Environment ====
Environment=PMA_ARBITRARY=1

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.phpmyadmin.loadbalancer.server.port=80
Label=traefik.http.routers.phpmyadmin.rule=Host(`myadmin.${FQDN}`)
Label=traefik.http.routers.phpmyadmin.entrypoints=websecure
Label=traefik.http.routers.phpmyadmin.tls.certresolver=letsencrypt
Label=traefik.http.routers.phpmyadmin.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
