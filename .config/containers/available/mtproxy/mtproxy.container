[Unit]
Description=mtproxy
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=ghcr.io/dofamin/mtproxy-docker:main
ContainerName=mtproxy
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=8388:8889

# ==== Volumes ====


# ==== Networks ====


# ==== Secrets ====
Secret=mtproxy_secret,type=env,target=SECRET

# ==== Environment ====
Environment=MTPROTO_REPO_URL=https://github.com/TelegramMessenger/MTProxy
Environment=WORKERS=1
Environment=TZ=Europe/Madrid

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
