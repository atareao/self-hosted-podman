[Unit]
Description=authentik-worker
After=network-online.target

[Container]
# ==== Image ====
Image=ghcr.io/goauthentik/server:2022.10.0
ContainerName=authentik-worker
PodmanArgs=--init

# ==== Command ====
Exec=worker

# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/authentik/media:/media:Z
Volume=%h/.config/authentik/certs:/certs:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=%h/.config/authentik/custom-templates:/templates:Z
Volume=authentik-geoip.volume:/geoip:Z

# ==== Networks ====
Network=authentik.network
NetworkAlias=worker

# ==== Secrets ====
Secret=authentik_postgresql__password,type=env,target=AUTHENTIK_POSTGRESQL__PASSWORD

# ==== Environment ====
Environment=AUTHENTIK_REDIS__HOST=redis
Environment=AUTHENTIK_POSTGRESQL__HOST=postgresql
Environment=AUTHENTIK_POSTGRESQL__USER=authentik
Environment=AUTHENTIK_POSTGRESQL__NAME=authentik

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====
User=root

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
