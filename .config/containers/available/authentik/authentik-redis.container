[Unit]
Description=redis
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/redis:alpine
ContainerName=authentik-redis

# ==== Command ====
Exec=--save 60 1 --loglevel warning

# ==== Ports ====


# ==== Volumes ====
Volume=authentik-redis.volume:/data:Z

# ==== Networks ====
Network=authentik.network
NetworkAlias=redis

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=redis-cli ping | grep PONG || exit 1
HealthInterval=30s
HealthRetries=5
HealthTimeout=3s
HealthStartPeriod=20s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
