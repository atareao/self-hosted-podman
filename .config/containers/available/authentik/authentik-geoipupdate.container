[Unit]
Description=authentik-geoipupdate
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/maxmindinc/geoipupdate:latest
AutoUpdate=registry
ContainerName=authentik-geoipupdate
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=authentik-geoip.volume:/usr/share/GeoIP:Z

# ==== Networks ====
Network=authentik.network
NetworkAlias=geoipupdate

# ==== Secrets ====


# ==== Environment ====
Environment=GEOIPUPDATE_EDITION_IDS=GeoLite2-City
Environment=GEOIPUPDATE_FREQUENCY=8

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
