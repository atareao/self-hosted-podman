[Unit]
Description=postgresql
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:12-alpine
ContainerName=postgresql
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=authentik-database.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=authentik.network

# ==== Secrets ====
Secret=authentik_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=authentik
Environment=POSTGRES_DB=authentik

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=pg_isready -d authentik -U authentik || exit 1
HealthInterval=30s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=20s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
