[Unit]
Description=trilium
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/zadam/trilium:latest
AutoUpdate=registry
ContainerName=trilium
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=trilium-trilium.volume:/home/node/trilium-data:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====
Environment=TRILIUM_DATA_DIR=

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.trilium.loadbalancer.server.port=8080
Label=traefik.http.routers.trilium.rule=Host(`trilium.{{ env.FQDN }}`)
Label=traefik.http.routers.trilium.entrypoints=websecure
Label=traefik.http.routers.trilium.tls.certresolver=letsencrypt
Label=traefik.http.routers.trilium.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
