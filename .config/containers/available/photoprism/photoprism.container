[Unit]
Description=photoprism
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/photoprism/photoprism:latest
ContainerName=photoprism
AutoUpdate=registry

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/photoprism/Pictures:/photoprism/originals:Z
Volume=%h/.config/photoprism/Storage:/photoprism/storage:Z
Volume=%h/.config/photoprism/Import:/photoprism/import:ro

# ==== Networks ====
Network=proxy.network
NetworkAlias=photoprism

# ==== Secrets ====
Secret=photoprism_admin_password,type=env,target=PHOTOPRISM_ADMIN_PASSWORD

# ==== Environment ====
Environment=PHOTOPRISM_ADMIN_USER=admin
Environment=PHOTOPRISM_SITE_URL=https://photoprism.${FQDN}/
Environment=TZ=Europe/Madrid

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.photoprism.loadbalancer.server.port=2342
Label=traefik.http.routers.photoprism.rule=Host(`photoprism.${FQDN}`)
Label=traefik.http.routers.photoprism.entrypoints=websecure
Label=traefik.http.routers.photoprism.tls.certresolver=letsencrypt
Label=traefik.http.routers.photoprism.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=curl -f -s -o /dev/null http://127.0.0.1:2342/ || exit 1
HealthInterval=60s
HealthRetries=5
HealthTimeout=15s
HealthStartPeriod=120s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
