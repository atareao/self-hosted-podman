[Unit]
Description=ittools
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/corentinth/it-tools
AutoUpdate=registry
ContainerName=ittools
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=ittools

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.ittools.loadbalancer.server.port=80
Label=traefik.http.routers.ittools.rule=Host(`ittools.${FQDN}`)
Label=traefik.http.routers.ittools.entrypoints=websecure
Label=traefik.http.routers.ittools.tls.certresolver=letsencrypt
Label=traefik.http.routers.ittools.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
