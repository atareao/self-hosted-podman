[Unit]
Description=yopass
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/jhaals/yopass
AutoUpdate=registry
ContainerName=yopass
PodmanArgs=--init

# ==== Command ====
Exec=--memcached=memcached:11211 --port 1337

# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
Network=yopass.network
NetworkAlias=yopass

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.yopass.loadbalancer.server.port=1337
Label=traefik.http.routers.yopass.rule=Host(`yopass.${FQDN}`)
Label=traefik.http.routers.yopass.entrypoints=websecure
Label=traefik.http.routers.yopass.tls.certresolver=letsencrypt
Label=traefik.http.routers.yopass.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
