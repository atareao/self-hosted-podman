[Unit]
Description=audiobookshelf
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/advplyr/audiobookshelf:latest
AutoUpdate=registry
ContainerName=audiobookshelf

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=audiobookshelf-books.volume:/books:Z
Volume=audiobookshelf-metadata.volume:/metadata:Z
Volume=audiobookshelf-config.volume:/config:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=audiobookshelf

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.audiobookshelf.loadbalancer.server.port=80
Label=traefik.http.routers.audiobookshelf.rule=Host(`books.{{ env.FQDN }}`)
Label=traefik.http.routers.audiobookshelf.entrypoints=websecure
Label=traefik.http.routers.audiobookshelf.tls.certresolver=letsencrypt
Label=traefik.http.routers.audiobookshelf.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
