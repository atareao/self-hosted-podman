[Unit]
Description=wallabag
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/wallabag/wallabag
AutoUpdate=registry
ContainerName=wallabag
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/wallabag/images:/var/www/wallabag/web/assets/images:Z
Volume=%h/.config/wallabag/data:/var/www/wallabag/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=wallabag

# ==== Secrets ====


# ==== Environment ====
Environment=SYMFONY__ENV__DOMAIN_NAME="https://wallabag.${FQDN}"
Environment=SYMFONY__ENV__SERVER_NAME=wallabag

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.wallabag.loadbalancer.server.port=80
Label=traefik.http.routers.wallabag.rule=Host(`wallabag.${FQDN}`)
Label=traefik.http.routers.wallabag.entrypoints=websecure
Label=traefik.http.routers.wallabag.tls.certresolver=letsencrypt
Label=traefik.http.routers.wallabag.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
