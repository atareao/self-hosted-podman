[Unit]
Description=mumble
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/mumblevoip/mumble-server
ContainerName=mumble
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====
PublishPort=64738:64738/tcp
PublishPort=64738:64738/udp

# ==== Volumes ====
Volume=mumble-data.volume:/data:Z

# ==== Networks ====
Network=proxy.network
Network=mumble.network
NetworkAlias=mumble

# ==== Secrets ====
Secret=mumble_superuser_password,type=env,target=MUMBLE_SUPERUSER_PASSWORD

# ==== Environment ====
EnvironmentFile=%h/.config/mumble/mumble.env
EnvironmentFile=%h/.config/mumble/mumble.env.local
Environment=MUMBLE_VERBOSE=true
Environment=MUMBLE_CONFIG_WELCOME_TEXT="Bienvenido"
Environment=MUMBLE_CONFIG_OPUSTHRESHOLD=0
Environment=MUMBLE_CONFIG_MESSAGEBURST=1
Environment=MUMBLE_CONFIG_MESSAGELIMIT=1
Environment=MUMBLE_CONFIG_USERS=10
Environment=MUMBLE_CONFIG_BANDWIDTH=512000

# ==== Labels ====

# ==== Healthcheck ====
# El daemon se llama `mumble-server` (PID 1 tras el exec de su-exec en el entrypoint).
# La imagen es Ubuntu y no trae procps, asi que comprobamos /proc/<pid>/comm.
HealthCmd=grep -qx mumble-server /proc/[0-9]*/comm || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
