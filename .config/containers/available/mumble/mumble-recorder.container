[Unit]
Description=mumble-recorder
After=network-online.target mumble.service
Requires=mumble.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/kaffetorsk/mumble-recorder
ContainerName=mumble-recorder
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====

# ==== Networks ====
Network=mumble.network
NetworkAlias=recorder

# ==== Secrets ====

# ==== Environment ====
# SERVER apunta al NetworkAlias de mumble dentro de mumble.network.
EnvironmentFile=%h/.config/mumble/mumble.env
EnvironmentFile=%h/.config/mumble/mumble.env.local
Environment=PASSWORD=
Environment=FFMPEG_OUT="-c:v copy -c:a copy -f flv rtmp://127.0.0.1:1935/live/{name}"

# ==== Labels ====

# ==== Healthcheck ====
# El demonio del recorder es el interprete Python (la imagen no trae procps);
# ffmpeg solo aparece cuando hay audio en un canal, no sirve como senal de vida.
HealthCmd=grep -q python3 /proc/[0-9]*/comm || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=60s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
