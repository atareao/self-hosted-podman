[Unit]
Description=recorder
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/kaffetorsk/mumble-recorder
ContainerName=recorder
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====

# ==== Networks ====
Network=mumble.network
NetworkAlias=recorder

# ==== Secrets ====

# ==== Environment ====
Environment=SERVER={{ env.SERVER_IP }}
Environment=PASSWORD=
Environment=FFMPEG_OUT="-c:v copy -c:a copy -f flv rtmp://127.0.0.1:1935/live/{name}"

# ==== Labels ====

# ==== Healthcheck ====

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
