[Unit]
Description=codimd
After=network-online.target codimd-postgresql.service traefik.service
Requires=codimd-postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/hackmdio/hackmd:2.4.2-cjk
ContainerName=codimd
AutoUpdate=registry

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=codimd-uploads.volume:/home/hackmd/app/public/uploads:U

# ==== Networks ====
Network=proxy.network
Network=codimd.network
NetworkAlias=codimd

# ==== Secrets ====
Secret=codimd_db_url,type=env,target=CMD_DB_URL
Secret=codimd_session_secret,type=env,target=CMD_SESSION_SECRET

# ==== Environment ====
Environment=CMD_DOMAIN=codimd.${FQDN}
Environment=CMD_PROTOCOL_USESSL=true
Environment=CMD_URL_ADDPORT=false

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.codimd.loadbalancer.server.port=3000
Label=traefik.http.routers.codimd.rule=Host(`codimd.${FQDN}`)
Label=traefik.http.routers.codimd.entrypoints=websecure
Label=traefik.http.routers.codimd.tls.certresolver=letsencrypt
Label=traefik.http.routers.codimd.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
