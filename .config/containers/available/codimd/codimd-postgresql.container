[Unit]
Description=codimd-postgresql
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:11.6-alpine
ContainerName=codimd-postgresql

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/codimd/codimddb:/var/lib/postgresql/data":Z

# ==== Networks ====
Network=codimd.network
NetworkAlias=codimddb

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
