[Unit]
Description=codimd-postgresql
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:17-alpine
ContainerName=codimd-postgresql
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=codimd-postgresql.volume:/var/lib/postgresql/data:U

# ==== Networks ====
Network=codimd.network
NetworkAlias=codimddb

# ==== Secrets ====
Secret=codimd_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=codimd
Environment=POSTGRES_DB=codimd
Environment=POSTGRES_HOST_AUTH_METHOD=md5
Environment=POSTGRES_INITDB_ARGS=--auth-host=md5

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=pg_isready -U codimd -d codimd
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=15s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
