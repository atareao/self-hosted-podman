[Unit]
Description=wikijs
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/requarks/wiki:2
ContainerName=wikijs
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=wikijs.network

# ==== Secrets ====
Secret=wikijs_postgres_password,type=env,target=POSTGRES_PASSWORD
Secret=wikijs_db_pass,type=env,target=DB_PASS

# ==== Environment ====
Environment=POSTGRES_DB=wiki
Environment=POSTGRES_USER=wikijs
Environment=DB_TYPE=postgres
Environment=DB_HOST=db
Environment=DB_PORT=5432
Environment=DB_USER=wikijs
Environment=DB_NAME=wiki

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.wikijs.loadbalancer.server.port=80
Label=traefik.http.routers.wikijs.rule=Host(`wikijs.{{ env.FQDN }}`)
Label=traefik.http.routers.wikijs.entrypoints=websecure
Label=traefik.http.routers.wikijs.tls.certresolver=letsencrypt
Label=traefik.http.routers.wikijs.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
