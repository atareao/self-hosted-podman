[Unit]
Description=postgres_for_wikijs
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:14-alpine
ContainerName=postgres_for_wikijs
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/wikijs/data:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=wikijs.network

# ==== Secrets ====


# ==== Environment ====
Environment=POSTGRES_DB=
Environment=POSTGRES_PASSWORD=
Environment=POSTGRES_USER=
Environment=DB_TYPE=
Environment=DB_HOST=
Environment=DB_PORT=
Environment=DB_USER=
Environment=DB_PASS=
Environment=DB_NAME=

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
