[Unit]
Description=glass-keep
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/nikunjsingh/glass-keep:latest
AutoUpdate=registry
ContainerName=glass-keep

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=glass-keep-data.volume:/app/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=keep

# ==== Secrets ====
Secret=glass_keep_jwt_secret,type=env,target=JWT_SECRET
Secret=glass_keep_initial_admin_password,type=env,target=INITIAL_ADMIN_PASSWORD

# ==== Environment ====
EnvironmentFile=%h/.config/glass-keep/glass-keep.env
EnvironmentFile=%h/.config/glass-keep/glass-keep.env.local
Environment=NODE_ENV=production
Environment=API_PORT=8080
Environment=DB_FILE=/app/data/notes.db

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.keep.loadbalancer.server.port=8080
Label=traefik.http.routers.keep.rule=Host(`keep.${FQDN}`)
Label=traefik.http.routers.keep.entrypoints=websecure
Label=traefik.http.routers.keep.tls.certresolver=letsencrypt
Label=traefik.http.routers.keep.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target