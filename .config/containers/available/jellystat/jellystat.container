[Unit]
Description=jellystat
After=network-online.target traefik.service jellystat-db.service
Requires=jellystat-db.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/cyfershepard/jellystat:latest
AutoUpdate=registry
ContainerName=jellystat
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=jellystat-backup-data.volume:/app/backend/backup-data:Z

# ==== Networks ====
Network=proxy.network
Network=jellystat.network
NetworkAlias=jellystat

# ==== Secrets ====
Secret=jellystat_postgres_password,type=env,target=POSTGRES_PASSWORD
Secret=jellystat_jwt_secret,type=env,target=JWT_SECRET

# ==== Environment ====
EnvironmentFile=%h/.config/jellystat/jellystat.env
EnvironmentFile=%h/.config/jellystat/jellystat.env.local
Environment=POSTGRES_IP=jellystat-db
Environment=POSTGRES_PORT=5432

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.jellystat.loadbalancer.server.port=3000
Label=traefik.http.routers.jellystat.rule=Host(`jellystat.${FQDN}`)
Label=traefik.http.routers.jellystat.entrypoints=websecure
Label=traefik.http.routers.jellystat.tls.certresolver=letsencrypt
Label=traefik.http.routers.jellystat.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=wget -q --spider http://127.0.0.1:3000/
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
