[Unit]
Description=jellystat-db
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:15.2
ContainerName=jellystat-db
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=jellystat-postgres-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=jellystat.network
NetworkAlias=jellystat-db

# ==== Secrets ====
Secret=jellystat_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
EnvironmentFile=%h/.config/jellystat/jellystat.env
EnvironmentFile=%h/.config/jellystat/jellystat.env.local

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=pg_isready -h 127.0.0.1 -U postgres
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
