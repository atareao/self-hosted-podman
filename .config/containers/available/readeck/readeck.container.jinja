[Unit]
Description=readeck
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=codeberg.org/readeck/readeck
AutoUpdate=registry
ContainerName=readeck
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=readeck-data.volume:/readeck:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.readeck.loadbalancer.server.port=8000
Label=traefik.http.routers.readeck.rule=Host(`readeck.{{ env.FQDN }}`)
Label=traefik.http.routers.readeck.entrypoints=websecure
Label=traefik.http.routers.readeck.tls.certresolver=letsencrypt
Label=traefik.http.routers.readeck.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
