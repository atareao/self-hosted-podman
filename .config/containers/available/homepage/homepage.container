[Unit]
Description=homepage
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/benphelps/homepage:latest
AutoUpdate=registry
ContainerName=homepage
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=homepage-config.volume:/app/config:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro

# ==== Networks ====
Network=proxy.network
NetworkAlias=homepage

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.homepage.loadbalancer.server.port=3000
Label=traefik.http.routers.homepage.rule=Host(`homepage.${FQDN}`)
Label=traefik.http.routers.homepage.entrypoints=websecure
Label=traefik.http.routers.homepage.tls.certresolver=letsencrypt
Label=traefik.http.routers.homepage.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
