[Unit]
Description=Gitea - Self-hosted Git Service
After=network-online.target gitea-db.service
Requires=gitea-db.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/gitea/gitea:1.19
ContainerName=gitea
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====
PublishPort=2222:22

# ==== Volumes ====
Volume=gitea-data.volume:/data:Z
Volume=/etc/localtime:/etc/localtime:ro

# ==== Networks ====
Network=gitea.network
Network=proxy.network

# ==== Secrets ====
Secret=gitea_db_password,type=env,target=GITEA__database__PASSWD

# ==== Environment ====
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=GITEA__database__DB_TYPE=postgres
Environment=GITEA__database__HOST=gitea-db:5432
Environment=GITEA__database__NAME=gitea
Environment=GITEA__database__USER=gitea
Environment=GITEA__repository__DEFAULT_BRANCH=main
Environment=GITEA__repository__ENABLE_PUSH_CREATE_ORG=true
Environment=GITEA__server__OFFLINE_MODE=true
Environment=GITEA__server__DOMAIN=gitea.${FQDN}
Environment=GITEA__server__SSH_DOMAIN=gitea.${FQDN}
Environment=GITEA__server__ROOT_URL=https://gitea.${FQDN}
Environment=GITEA__server__DISABLE_SSH=false
Environment=GITEA__server__SSH_PORT=2222
Environment=GITEA__server__SSH_LISTEN_PORT=22
Environment=GITEA__service__DISABLE_REGISTRATION=true
Environment=GITEA__service__REQUIRE_SIGNIN_VIEW=true
Environment=GITEA__service__DEFAULT_ALLOW_CREATE_ORGANIZATION=false
Environment=GITEA__security__REVERSE_PROXY_TRUSTED_PROXIES=10.89.0.0/24

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.gitea.loadbalancer.server.port=3000
Label=traefik.http.routers.gitea.rule=Host(`gitea.${FQDN}`)
Label=traefik.http.routers.gitea.entrypoints=websecure
Label=traefik.http.routers.gitea.tls.certresolver=letsencrypt
Label=traefik.http.routers.gitea.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=curl -fsS http://127.0.0.1:3000/api/healthz
HealthInterval=30s
HealthRetries=5
HealthTimeout=10s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=90

[Install]
WantedBy=default.target