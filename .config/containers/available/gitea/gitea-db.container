[Unit]
Description=Gitea PostgreSQL Database
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:14
ContainerName=gitea-db

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=gitea-db-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=gitea.network

# ==== Secrets ====
Secret=gitea_db_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=gitea
Environment=POSTGRES_DB=gitea

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=pg_isready -U gitea -d gitea
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target