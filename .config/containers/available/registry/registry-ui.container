[Unit]
Description=registry-ui
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/joxit/docker-registry-ui:main
ContainerName=registry-ui

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
Network=registry.network
NetworkAlias=registry-ui

# ==== Secrets ====
Secret=registry_nginx_proxy_pass_url,type=env,target=NGINX_PROXY_PASS_URL

# ==== Environment ====
Environment=SINGLE_REGISTRY=true
Environment=REGISTRY_TITLE="Atareao Docker Registry"
Environment=DELETE_IMAGES=true
Environment=SHOW_CONTENT_DIGEST=true
Environment=SHOW_CATALOG_NB_TAGS=true
Environment=CATALOG_MIN_BRANCHES=1
Environment=CATALOG_MAX_BRANCHES=1
Environment=TAGLIST_PAGE_SIZE=100
Environment=REGISTRY_SECURED=false
Environment=CATALOG_ELEMENTS_LIMIT=1000

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.registryui.loadbalancer.server.port=80
Label=traefik.http.routers.registryui.rule=Host(`tu.${FQDN}`)
Label=traefik.http.routers.registryui.entrypoints=websecure
Label=traefik.http.routers.registryui.tls.certresolver=letsencrypt
Label=traefik.http.routers.registryui.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
