[Unit]
Description=registry
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/registry
AutoUpdate=registry
ContainerName=registry
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=registry-data.volume:/var/lib/registry:Z
Volume=%h/.config/registry/config.yml:/etc/docker/registry/config.yml:Z
Volume=%h/.config/registry/htpasswd:/auth/htpasswd:ro

# ==== Networks ====
Network=registry.network
NetworkAlias=registry

# ==== Secrets ====


# ==== Environment ====
Environment=REGISTRY_STORAGE_DELETE_ENABLED=true

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
