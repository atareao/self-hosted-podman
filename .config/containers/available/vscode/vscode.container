[Unit]
Description=vscode
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=lscr.io/linuxserver/code-server
AutoUpdate=registry
ContainerName=vscode

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/vscode/config:/config:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=code-server

# ==== Secrets ====
Secret=vscode_password,type=env,target=PASSWORD

# ==== Environment ====
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Madrid

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.vscode.loadbalancer.server.port=8443
Label=traefik.http.routers.vscode.rule=Host(`vscode.${FQDN}`)
Label=traefik.http.routers.vscode.entrypoints=websecure
Label=traefik.http.routers.vscode.tls.certresolver=letsencrypt
Label=traefik.http.routers.vscode.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
