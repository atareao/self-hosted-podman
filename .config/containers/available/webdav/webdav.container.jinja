[Unit]
Description=webdav
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/atareao/webdav:v2.0
ContainerName=webdav

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/webdav/share:/share:Z
Volume=%h/.config/webdav/htpasswd:/opt/nginx/conf/.htpasswd:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=webdav

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.webdav.loadbalancer.server.port=8080
Label=traefik.http.routers.webdav.rule=Host(`webdav.{{ env.FQDN }}`)
Label=traefik.http.routers.webdav.entrypoints=websecure
Label=traefik.http.routers.webdav.tls.certresolver=letsencrypt
Label=traefik.http.routers.webdav.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
