[Unit]
Description=invidious-postgresql
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:14
ContainerName=invidious-postgresql
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=invidious-postgresdata.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=invidious.network
NetworkAlias=postgres

# ==== Secrets ====
Secret=invidious_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_DB=invidious
Environment=POSTGRES_USER=kemal

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=pg_isready -U kemal -d invidious || exit 1

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
