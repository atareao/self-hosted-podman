[Unit]
Description=bentopdf
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/bentopdf/bentopdf
AutoUpdate=registry
ContainerName=bentopdf
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=bentopdf

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.pdf.loadbalancer.server.port=8080
Label=traefik.http.routers.pdf.rule=Host(`pdf.${FQDN}`)
Label=traefik.http.routers.pdf.entrypoints=websecure
Label=traefik.http.routers.pdf.tls.certresolver=letsencrypt
Label=traefik.http.routers.pdf.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
