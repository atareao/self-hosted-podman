[Unit]
Description=pastebin
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/mkaczanowski/pastebin:latest
ContainerName=pastebin
PodmanArgs=--init

# ==== Command ====


Exec=--address 0.0.0.0 --port 8081 --db=/rs/db/pastebin.db
# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/pastebin/db:/rs/db:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=pastebin

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.pastebin.loadbalancer.server.port=8081
Label=traefik.http.routers.pastebin.rule=Host(`pastebin.${FQDN}`)
Label=traefik.http.routers.pastebin.entrypoints=websecure
Label=traefik.http.routers.pastebin.tls.certresolver=letsencrypt
Label=traefik.http.routers.pastebin.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
