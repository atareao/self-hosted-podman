[Unit]
Description=pastebin
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/atareao/pastebin:v1.0
ContainerName=pastebin
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/pastebin/db:/rs/db:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.pastebin.loadbalancer.server.port=8081
Label=traefik.http.routers.pastebin.rule=Host(`pastebin.{{ env.FQDN }}`)
Label=traefik.http.routers.pastebin.entrypoints=websecure
Label=traefik.http.routers.pastebin.tls.certresolver=letsencrypt
Label=traefik.http.routers.pastebin.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
