[Unit]
Description=Dozzle - Podman Log Viewer
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/amir20/dozzle:latest
ContainerName=dozzle
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====
Secret=dozzle_username,type=env,target=DOZZLE_USERNAME
Secret=dozzle_password,type=env,target=DOZZLE_PASSWORD

# ==== Environment ====

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.dozzle.loadbalancer.server.port=8080
Label=traefik.http.routers.dozzle.rule=Host(`dozzle.${FQDN}`)
Label=traefik.http.routers.dozzle.entrypoints=websecure
Label=traefik.http.routers.dozzle.tls.certresolver=letsencrypt
Label=traefik.http.routers.dozzle.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
