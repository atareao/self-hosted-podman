[Unit]
Description=focalboard
After=network-online.target traefik.service focalboard-postgresql.service
Requires=focalboard-postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/mattermost/focalboard:latest
ContainerName=focalboard
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=focalboard-data.volume:/opt/focalboard/files:Z

# ==== Networks ====
Network=proxy.network
Network=focalboard.network
NetworkAlias=focalboard

# ==== Secrets ====
Secret=focalboard_database_url,type=env,target=FOCALBOARD_DBCONFIG

# ==== Environment ====
Environment=FOCALBOARD_DBTYPE=postgres
Environment=TZ=Europe/Madrid

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.focalboard.loadbalancer.server.port=8000
Label=traefik.http.routers.focalboard.rule=Host(`focalboard.${FQDN}`)
Label=traefik.http.routers.focalboard.entrypoints=websecure
Label=traefik.http.routers.focalboard.tls.certresolver=letsencrypt
Label=traefik.http.routers.focalboard.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
