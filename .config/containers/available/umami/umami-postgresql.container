[Unit]
Description=Umami PostgreSQL Database
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:18-alpine
ContainerName=umami-postgresql
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=umami-data.volume:/var/lib/postgresql:Z

# ==== Networks ====
Network=umami.network
NetworkAlias=umamidb

# ==== Secrets ====
Secret=umamidb_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_DB=umami
Environment=POSTGRES_USER=umami
Environment=TZ=Europe/Madrid

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=pg_isready -U umami -d umami
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target