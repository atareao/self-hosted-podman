[Unit]
Description=Umami Analytics
After=network-online.target umamidb.service proxy.network
Requires=umamidb.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=ghcr.io/umami-software/umami:postgresql-latest
ContainerName=umami
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====

# ==== Networks ====
Network=umami.network
Network=proxy.network

# ==== Secrets ====
Secret=umami_app_secret,type=env,target=APP_SECRET
Secret=umami_database_url,type=env,target=DATABASE_URL

# ==== Environment ====
Environment=DATABASE_TYPE=postgresql
Environment=TZ=Europe/Madrid

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.umami.loadbalancer.server.port=3000
Label=traefik.http.routers.umami.rule=Host(`umami.${FQDN}`)
Label=traefik.http.routers.umami.entrypoints=websecure
Label=traefik.http.routers.umami.tls.certresolver=letsencrypt
Label=traefik.http.routers.umami.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=curl -f http://localhost:3000/api/heartbeat || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60
ExecStartPost=/usr/bin/bash -c 'while [ "$(podman inspect --format "{{.State.Health.Status}}" umami)" != "healthy" ]; do sleep 2; done'

[Install]
WantedBy=default.target