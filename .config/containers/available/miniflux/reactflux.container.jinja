[Unit]
Description=reactflux
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/electh/reactflux
AutoUpdate=registry
ContainerName=reactflux
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.reactflux.loadbalancer.server.port=2000
Label=traefik.http.routers.reactflux.rule=Host(`miniflux.{{ env.FQDN }}`)
Label=traefik.http.routers.reactflux.entrypoints=websecure
Label=traefik.http.routers.reactflux.tls.certresolver=letsencrypt
Label=traefik.http.routers.reactflux.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
