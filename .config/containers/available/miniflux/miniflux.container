[Unit]
Description=miniflux
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/miniflux/miniflux:latest
AutoUpdate=registry
ContainerName=miniflux
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
Network=miniflux.network
NetworkAlias=miniflux

# ==== Secrets ====
Secret=miniflux_database_url,type=env,target=DATABASE_URL
Secret=miniflux_admin_password,type=env,target=ADMIN_PASSWORD

# ==== Environment ====
Environment=RUN_MIGRATIONS=$RUN_MIGRATIONS
Environment=CREATE_ADMIN=$CREATE_ADMIN
Environment=ADMIN_USERNAME=$ADMIN_USERNAME

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.miniflux.loadbalancer.server.port=8080
Label=traefik.http.routers.miniflux.rule=Host(`miniflux.${FQDN}`)
Label=traefik.http.routers.miniflux.entrypoints=websecure
Label=traefik.http.routers.miniflux.tls.certresolver=letsencrypt
Label=traefik.http.routers.miniflux.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
