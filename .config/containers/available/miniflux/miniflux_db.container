[Unit]
Description=miniflux_db
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:18-alpine
ContainerName=miniflux_db
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=miniflux-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=miniflux.network

# ==== Secrets ====


# ==== Environment ====
Environment=POSTGRES_USER=
Environment=POSTGRES_PASSWORD=

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=pg_isready -U miniflux || exit 1
HealthInterval=30s
HealthStartPeriod=30s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
