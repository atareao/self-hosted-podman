[Unit]
Description=miniflux-postgresql
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:18-alpine
ContainerName=miniflux-postgresql
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=miniflux-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=miniflux.network
NetworkAlias=miniflux_db

# ==== Secrets ====
Secret=miniflux_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
EnvironmentFile=%h/.config/miniflux/miniflux.env
EnvironmentFile=%h/.config/miniflux/miniflux.env.local


# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=pg_isready -U miniflux || exit 1
HealthInterval=30s
HealthStartPeriod=30s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
