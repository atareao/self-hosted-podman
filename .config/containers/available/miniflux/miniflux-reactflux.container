[Unit]
Description=miniflux-reactflux
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/electh/reactflux:2026.11.07
AutoUpdate=registry
ContainerName=miniflux-reactflux
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=reactflux

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.reactflux.loadbalancer.server.port=2000
Label=traefik.http.routers.reactflux.rule=Host(`reactflux.${FQDN}`)
Label=traefik.http.routers.reactflux.entrypoints=websecure
Label=traefik.http.routers.reactflux.tls.certresolver=letsencrypt
Label=traefik.http.routers.reactflux.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=wget -q --spider http://localhost:2000/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=10s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
