[Unit]
Description=kanboard
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/kanboard/kanboard:latest
AutoUpdate=registry
ContainerName=kanboard

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/kanboard/kanboard_data:/var/www/app/data:Z
Volume=%h/.config/kanboard/kanboard_plugins:/var/www/app/plugins:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=kanboard

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.kanboard.loadbalancer.server.port=80
Label=traefik.http.routers.kanboard.rule=Host(`kanboard.${FQDN}`)
Label=traefik.http.routers.kanboard.entrypoints=websecure
Label=traefik.http.routers.kanboard.tls.certresolver=letsencrypt
Label=traefik.http.routers.kanboard.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
