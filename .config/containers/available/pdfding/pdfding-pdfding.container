[Unit]
Description=pdfding
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/mrmn/pdfding:latest
AutoUpdate=registry
ContainerName=pdfding-pdfding
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=pdfding-db.volume:/home/nonroot/pdfding/db:Z
Volume=pdfding-media.volume:/home/nonroot/pdfding/media:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=pdfding

# ==== Secrets ====
Secret=pdfding_secret_key,type=env,target=SECRET_KEY

# ==== Environment ====
Environment=DEFAULT_THEME=dark
Environment=DEFAULT_THEME_COLOR=blue
Environment=HOST_NAME="pdfding.${FQDN}"
Environment=CSRF_COOKIE_SECURE=TRUE
Environment=SESSION_COOKIE_SECURE=TRUE

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.pdfding.loadbalancer.server.port=8000
Label=traefik.http.routers.pdfding.rule=Host(`pdfding.${FQDN}`)
Label=traefik.http.routers.pdfding.entrypoints=websecure
Label=traefik.http.routers.pdfding.tls.certresolver=letsencrypt
Label=traefik.http.routers.pdfding.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
