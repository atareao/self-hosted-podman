[Unit]
Description=homer
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/b4bz/homer
AutoUpdate=registry
ContainerName=homer
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/homer/assets:/www/assets:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=homer

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.homer.loadbalancer.server.port=8080
Label=traefik.http.routers.homer.rule=Host(`homer.{{ env.FQDN }}`)
Label=traefik.http.routers.homer.entrypoints=websecure
Label=traefik.http.routers.homer.tls.certresolver=letsencrypt
Label=traefik.http.routers.homer.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====
User=1000:1000

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
