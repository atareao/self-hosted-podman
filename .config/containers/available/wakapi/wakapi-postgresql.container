[Unit]
Description=wakapi-postgresql
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
 
[Container]
# ==== Image ====
Image=docker.io/library/postgres:17
ContainerName=wakapi-postgresql
PodmanArgs=--init
 
# ==== Command ====
 
 
# ==== Ports ====
 
 
# ==== Volumes ====
Volume=wakapi-pg.volume:/var/lib/postgresql/data:Z
 
# ==== Networks ====
Network=wakapi.network
NetworkAlias=db
 
# ==== Secrets ====
Secret=wakapi_postgres_password,type=env,target=POSTGRES_PASSWORD
 
# ==== Environment ====
EnvironmentFile=%h/.config/wakapi/wakapi.env
EnvironmentFile=%h/.config/wakapi/wakapi.env.local
 
# ==== Labels ====
 
 
# ==== Healthcheck ====
 
 
# ==== Hardening ====
 
 
# ==== Resources ====
 
[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60
 
[Install]
WantedBy=default.target
