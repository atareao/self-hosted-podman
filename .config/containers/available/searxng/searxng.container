[Unit]
Description=searxng
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/searxng/searxng:latest
AutoUpdate=registry
ContainerName=searxng
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=searxng-data.volume:/etc/searxng:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=searxng

# ==== Secrets ====


# ==== Environment ====
Environment=SEARXNG_BASE_URL=https://localhost/

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.searxng.loadbalancer.server.port=8080
Label=traefik.http.routers.searxng.rule=Host(`searxng.${FQDN}`)
Label=traefik.http.routers.searxng.entrypoints=websecure
Label=traefik.http.routers.searxng.tls.certresolver=letsencrypt
Label=traefik.http.routers.searxng.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
