[Unit]
Description=redis
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/redis:alpine
ContainerName=searxng-redis
PodmanArgs=--init

# ==== Command ====
Exec=redis-server --save "" --appendonly "no"

# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=searxng.network
NetworkAlias=redis

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
