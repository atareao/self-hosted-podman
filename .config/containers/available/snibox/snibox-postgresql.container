[Unit]
Description=snibox-postgresql
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:10.7-alpine
ContainerName=snibox-postgresql
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=snibox-pg-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=snibox.network
NetworkAlias=database

# ==== Secrets ====
Secret=snibox_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
