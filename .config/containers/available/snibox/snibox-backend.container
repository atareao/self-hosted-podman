[Unit]
Description=snibox-backend
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/snibox/snibox:latest
AutoUpdate=registry
ContainerName=snibox-backend
PodmanArgs=--init

# ==== Command ====
Exec=sh -c "rm -rf tmp/pids && ./bin/rails s -p 3000 -b '0.0.0.0'"

# ==== Ports ====


# ==== Volumes ====
Volume=snibox-static-files.volume:/app/public:Z

# ==== Networks ====
Network=snibox.network
NetworkAlias=backend

# ==== Secrets ====
Secret=snibox_db_pass,type=env,target=DB_PASS
Secret=snibox_mailgun_smtp_password,type=env,target=MAILGUN_SMTP_PASSWORD
Secret=snibox_mailgun_api_key,type=env,target=MAILGUN_API_KEY
Secret=snibox_mailgun_public_key,type=env,target=MAILGUN_PUBLIC_KEY
Secret=snibox_secret_key_base,type=env,target=SECRET_KEY_BASE

# ==== Environment ====
Environment=DB_NAME=postgres
Environment=DB_USER=postgres
Environment=DB_HOST=database
Environment=DB_PORT=5432
Environment=FORCE_SSL=false
Environment=MAILGUN_SMTP_PORT=587
Environment=MAILGUN_SMTP_SERVER=smtp.mailgun.org
Environment=MAILGUN_SMTP_LOGIN=
Environment=MAILGUN_DOMAIN=

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
