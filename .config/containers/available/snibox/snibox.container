[Unit]
Description=snibox
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/snibox/nginx-puma:1.15.9
ContainerName=snibox
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=snibox-static-files.volume:/var/www/html:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=snibox

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.snibox.loadbalancer.server.port=80
Label=traefik.http.routers.snibox.rule=Host(`snibox.${FQDN}`)
Label=traefik.http.routers.snibox.entrypoints=websecure
Label=traefik.http.routers.snibox.tls.certresolver=letsencrypt
Label=traefik.http.routers.snibox.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
