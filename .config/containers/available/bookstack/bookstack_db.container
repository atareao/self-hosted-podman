[Unit]
Description=bookstack_db
After=network-online.target

[Container]
# ==== Image ====
Image=lscr.io/linuxserver/mariadb
AutoUpdate=registry
ContainerName=bookstack_db

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/bookstack/config:/config:Z

# ==== Networks ====
Network=bookstack.network

# ==== Secrets ====
Secret=bookstack_mysql_root_password,type=env,target=MYSQL_ROOT_PASSWORD
Secret=bookstack_mysql_password,type=env,target=MYSQL_PASSWORD

# ==== Environment ====
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Madrid
Environment=MYSQL_DATABASE=bookstackapp
Environment=MYSQL_USER=bookstack

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
