[Unit]
Description=bookstack
After=network-online.target traefik.service bookstack-mariadb.service
Requires=bookstack-mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=lscr.io/linuxserver/bookstack:latest
ContainerName=bookstack
AutoUpdate=registry

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=%h/.config/bookstack/config:/config:Z

# ==== Networks ====
Network=bookstack.network
Network=proxy.network
NetworkAlias=bookstack

# ==== Secrets ====
Secret=bookstack_db_pass,type=env,target=DB_PASS

# ==== Environment ====
Environment=PUID=1000
Environment=PGID=1000
Environment=APP_URL="https://bookstack.${FQDN}"
Environment=DB_HOST=bookstack_db
Environment=DB_USER=bookstack
Environment=DB_DATABASE=bookstackapp

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.bookstack.loadbalancer.server.port=80
Label=traefik.http.routers.bookstack.rule=Host(`bookstack.${FQDN}`)
Label=traefik.http.routers.bookstack.entrypoints=websecure
Label=traefik.http.routers.bookstack.tls.certresolver=letsencrypt
Label=traefik.http.routers.bookstack.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
