[Unit]
Description=wordpress-wp2-mariadb
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mariadb
AutoUpdate=registry
ContainerName=wordpress-wp2-mariadb
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=wordpress-wp2-mariadb.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=wordpress-wp2.network
NetworkAlias=mariadb

# ==== Secrets ====
Secret=wordpress_wp2_mysql_password,type=env,target=MYSQL_PASSWORD
Secret=wordpress_wp2_mariadb_root_password,type=env,target=MARIADB_ROOT_PASSWORD

# ==== Environment ====
Environment=MYSQL_DATABASE=wp2
Environment=MYSQL_USER=wp2

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
