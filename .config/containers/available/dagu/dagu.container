[Unit]
Description=dagu
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=ghcr.io/dagucloud/dagu:latest
AutoUpdate=registry
ContainerName=dagu
PodmanArgs=--init

# ==== Command ====
Exec=dagu start-all

# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=dagu

# ==== Secrets ====
Secret=dagu_basicauth_password,type=env,target=DAGU_BASICAUTH_PASSWORD

# ==== Environment ====
Environment=DAGU_TZ=Europe/Madrid
Environment=DAGU_IS_BASICAUTH=1
Environment=DAGU_BASICAUTH_USERNAME=usuario

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.dagu.loadbalancer.server.port=8080
Label=traefik.http.routers.dagu.rule=Host(`dagu.${FQDN}`)
Label=traefik.http.routers.dagu.entrypoints=websecure
Label=traefik.http.routers.dagu.tls.certresolver=letsencrypt
Label=traefik.http.routers.dagu.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
