[Unit]
Description=notemark
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/enchant97/note-mark-aio
AutoUpdate=registry
ContainerName=notemark
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=notemark-data.volume:/data:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====
Secret=notemark_jwt_secret,type=env,target=JWT_SECRET

# ==== Environment ====
Environment=CORS_ORIGINS="https://notemark.{{ env.FQDN }}"
Environment=PUBLIC_URL="https://notemark.{{ env.FQDN }}"
Environment=ALLOW_SIGNUP=False
Environment=ENABLE_INTERNAL_SIGNUP=False

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.notemark.loadbalancer.server.port=8080
Label=traefik.http.routers.notemark.rule=Host(`notemark.{{ env.FQDN }}`)
Label=traefik.http.routers.notemark.entrypoints=websecure
Label=traefik.http.routers.notemark.tls.certresolver=letsencrypt
Label=traefik.http.routers.notemark.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
