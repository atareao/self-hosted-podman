[Unit]
Description=immich-postgresql
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:14
ContainerName=immich-postgresql

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=immich-pgdata.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=immich.network
NetworkAlias=database

# ==== Secrets ====
Secret=immich_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=PG_DATA=/var/lib/postgresql/data

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
