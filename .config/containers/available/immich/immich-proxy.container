[Unit]
Description=immich-proxy
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/altran1502/immich-proxy:release
ContainerName=immich-proxy

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=immich-proxy

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.immich.loadbalancer.server.port=8080
Label=traefik.http.routers.immich.rule=Host(`immich.${FQDN}`)
Label=traefik.http.routers.immich.entrypoints=websecure
Label=traefik.http.routers.immich.tls.certresolver=letsencrypt
Label=traefik.http.routers.immich.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
