[Unit]
Description=immich-microservices
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/altran1502/immich-server:release
ContainerName=immich-microservices

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/immich/upload:/usr/src/app/upload:Z

# ==== Networks ====
Network=immich.network
NetworkAlias=immich-microservices

# ==== Secrets ====


# ==== Environment ====
Environment=NODE_ENV=production

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
