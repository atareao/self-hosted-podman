[Unit]
Description=memos
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/neosmemo/memos:latest
AutoUpdate=registry
ContainerName=memos
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=memos-memos.volume:/var/opt/memos:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=memos

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.memos.loadbalancer.server.port=5230
Label=traefik.http.routers.memos.rule=Host(`memos.{{ env.FQDN }}`)
Label=traefik.http.routers.memos.entrypoints=websecure
Label=traefik.http.routers.memos.tls.certresolver=letsencrypt
Label=traefik.http.routers.memos.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
