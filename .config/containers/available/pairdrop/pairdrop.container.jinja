[Unit]
Description=pairdrop
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/schlagmichdoch/pairdrop
AutoUpdate=registry
ContainerName=pairdrop
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.pairdrop.loadbalancer.server.port=3000
Label=traefik.http.routers.pairdrop.rule=Host(`pairdrop.{{ env.FQDN }}`)
Label=traefik.http.routers.pairdrop.entrypoints=websecure
Label=traefik.http.routers.pairdrop.tls.certresolver=letsencrypt
Label=traefik.http.routers.pairdrop.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
