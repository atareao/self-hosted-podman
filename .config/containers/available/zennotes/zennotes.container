[Unit]
Description=zennotes — notas Markdown self-hosted
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/adibhanna/zennotes:latest
ContainerName=zennotes
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=zennotes-vault.volume:/workspace:Z
Volume=zennotes-data.volume:/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=zennotes

# ==== Secrets ====
Secret=zennotes_auth_token,type=env,target=ZENNOTES_AUTH_TOKEN

# ==== Environment ====
EnvironmentFile=%h/.config/zennotes/zennotes.env
EnvironmentFile=%h/.config/zennotes/zennotes.env.local

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.zennotes.loadbalancer.server.port=7878
Label=traefik.http.routers.zennotes.rule=Host(`zennotes.${FQDN}`)
Label=traefik.http.routers.zennotes.entrypoints=websecure
Label=traefik.http.routers.zennotes.tls.certresolver=letsencrypt
Label=traefik.http.routers.zennotes.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=["/zennotes-server","healthcheck"]
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=5s

# ==== Hardening ====
NoNewPrivileges=true
User=1000:1000

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60
ExecStartPost=/usr/bin/bash -c 'while [ "$(podman inspect --format "{{.State.Health.Status}}" zennotes)" != "healthy" ]; do sleep 2; done'

[Install]
WantedBy=default.target
