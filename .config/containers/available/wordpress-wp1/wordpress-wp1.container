[Unit]
Description=wordpress-wp1
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/library/wordpress
AutoUpdate=registry
ContainerName=wordpress-wp1
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=wordpress-wp1-data.volume:/var/www/html:Z
Volume=%h/.config/wordpress-wp1/plugins:/var/www/html/wp-content/plugins:Z
Volume=%h/.config/wordpress-wp1/themes:/var/www/html/wp-content/themes:Z
Volume=%h/.config/wordpress-wp1/uploads:/var/www/html/wp-content/uploads:Z
Volume=%h/.config/wordpress-wp1/wp-config.php:/var/www/html/wp-config.php:Z

# ==== Networks ====
Network=proxy.network
Network=wordpress-wp1.network
NetworkAlias=wordpress

# ==== Secrets ====
Secret=wordpress_wp1_wordpress_db_password,type=env,target=WORDPRESS_DB_PASSWORD

# ==== Environment ====
Environment=WORDPRESS_DB_HOST=mariadb
Environment=WORDPRESS_DB_USER=wp1
Environment=WORDPRESS_DB_NAME=wp1

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.wordpress-wp1.loadbalancer.server.port=80
Label=traefik.http.routers.wordpress-wp1.rule=Host(`wp1.${FQDN}`)
Label=traefik.http.routers.wordpress-wp1.entrypoints=websecure
Label=traefik.http.routers.wordpress-wp1.tls.certresolver=letsencrypt
Label=traefik.http.routers.wordpress-wp1.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
