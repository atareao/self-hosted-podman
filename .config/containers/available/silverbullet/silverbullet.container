[Unit]
Description=silverbullet
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/atareao/silverbullet:latest
AutoUpdate=registry
ContainerName=silverbullet

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/silverbullet/space:/space:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=silverbullet

# ==== Secrets ====
Secret=silverbullet_sb_user,type=env,target=SB_USER

# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.silverbullet.loadbalancer.server.port=3000
Label=traefik.http.routers.silverbullet.rule=Host(`silverbullet.${FQDN}`)
Label=traefik.http.routers.silverbullet.entrypoints=websecure
Label=traefik.http.routers.silverbullet.tls.certresolver=letsencrypt
Label=traefik.http.routers.silverbullet.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
