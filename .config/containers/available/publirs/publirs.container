[Unit]
Description=publirs
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/atareao/publirs:latest
AutoUpdate=registry
ContainerName=publirs
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=publirs-db.volume:/app/db:Z

# ==== Networks ====
Network=publirs.network
NetworkAlias=publirs
Network=proxy.network
NetworkAlias=publirs

# ==== Secrets ====
Secret=publirs_token,type=env,target=TOKEN

# ==== Environment ====
Environment=LOG_LEVEL=debug
Environment=DB_URL=sqlite:/app/db/publirs.db
Environment=PORT=8080
Environment=ENVIRONMENT=PRODUCTION

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.publirs.loadbalancer.server.port=8080
Label=traefik.http.routers.publirs.rule=Host(`publirs.${FQDN}`)
Label=traefik.http.routers.publirs.entrypoints=websecure
Label=traefik.http.routers.publirs.tls.certresolver=letsencrypt
Label=traefik.http.routers.publirs.middlewares=seguridadHeaders@file,compresionHeaders@file


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
