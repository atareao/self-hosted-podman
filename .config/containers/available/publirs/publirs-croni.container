[Unit]
Description=croni
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/atareao/croni:latest
AutoUpdate=registry
ContainerName=publirs-croni
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=/etc/timezone:/etc/timezone:ro
Volume=/etc/localtime:/etc/localtime:ro

# ==== Networks ====
Network=publirs.network
NetworkAlias=croni

# ==== Secrets ====


# ==== Environment ====
Environment=LOGLEVEL=debug

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
