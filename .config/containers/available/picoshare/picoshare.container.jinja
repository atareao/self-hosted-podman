[Unit]
Description=picoshare
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/mtlynch/picoshare
AutoUpdate=registry
ContainerName=picoshare
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=picoshare-picoshare.volume:/data:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====
Environment=PORT=
Environment=PS_SHARED_SECRET=

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.picoshare.loadbalancer.server.port=4001
Label=traefik.http.routers.picoshare.rule=Host(`picoshare.{{ env.FQDN }}`)
Label=traefik.http.routers.picoshare.entrypoints=websecure
Label=traefik.http.routers.picoshare.tls.certresolver=letsencrypt
Label=traefik.http.routers.picoshare.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
