[Unit]
Description=Beszel - Server Monitoring Hub
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/henrygd/beszel:latest
ContainerName=beszel
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=beszel-data.volume:/beszel_data:Z
Volume=beszel-socket.volume:/beszel_socket:Z

# ==== Networks ====
Network=beszel.network
Network=proxy.network

# ==== Secrets ====

# ==== Environment ====
Environment=DISABLE_PASSWORD_AUTH=true

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.beszel.loadbalancer.server.port=8090
Label=traefik.http.routers.beszel.rule=Host(`beszel.${FQDN}`)
Label=traefik.http.routers.beszel.entrypoints=websecure
Label=traefik.http.routers.beszel.tls.certresolver=letsencrypt
Label=traefik.http.routers.beszel.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target