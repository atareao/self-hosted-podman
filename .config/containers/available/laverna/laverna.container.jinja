[Unit]
Description=laverna
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/atareao/laverna:v1.0
ContainerName=laverna

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/laverna/htpasswd:/opt/nginx/conf/htpasswd:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.laverna.loadbalancer.server.port=8080
Label=traefik.http.routers.laverna.rule=Host(`laverna.{{ env.FQDN }}`)
Label=traefik.http.routers.laverna.entrypoints=websecure
Label=traefik.http.routers.laverna.tls.certresolver=letsencrypt
Label=traefik.http.routers.laverna.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
