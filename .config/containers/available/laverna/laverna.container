[Unit]
Description=laverna
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/olegfiksel/laverna:0.7.54
ContainerName=laverna
AutoUpdate=registry

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=laverna

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.laverna.loadbalancer.server.port=80
Label=traefik.http.routers.laverna.rule=Host(`laverna.${FQDN}`)
Label=traefik.http.routers.laverna.entrypoints=websecure
Label=traefik.http.routers.laverna.tls.certresolver=letsencrypt
Label=traefik.http.routers.laverna.middlewares=laverna-auth@file,seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
