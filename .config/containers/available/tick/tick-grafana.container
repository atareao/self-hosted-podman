[Unit]
Description=Grafana (stack tick)
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/grafana/grafana
AutoUpdate=registry
ContainerName=tick-grafana

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=tick-grafana.volume:/var/lib/grafana:Z

# ==== Networks ====
Network=proxy.network
Network=tick.network
NetworkAlias=grafana

# ==== Secrets ====

# ==== Environment ====
EnvironmentFile=%h/.config/tick/tick.env
EnvironmentFile=%h/.config/tick/tick.env.local

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.tick-grafana.loadbalancer.server.port=3000
Label=traefik.http.routers.tick-grafana.rule=Host(`tick.${FQDN}`)
Label=traefik.http.routers.tick-grafana.entrypoints=websecure
Label=traefik.http.routers.tick-grafana.tls.certresolver=letsencrypt
Label=traefik.http.routers.tick-grafana.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====
User=1000:1000

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
