[Unit]
Description=grafana
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/grafana/grafana
AutoUpdate=registry
ContainerName=tick-grafana

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=tick-grafana_data.volume:/var/lib/grafana:Z

# ==== Networks ====
Network=proxy.network
Network=tick.network
NetworkAlias=grafana

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.tick-grafana.loadbalancer.server.port=3000
Label=traefik.http.routers.tick-grafana.rule=Host(`tick.${FQDN}`)
Label=traefik.http.routers.tick-grafana.entrypoints=websecure
Label=traefik.http.routers.tick-grafana.tls.certresolver=letsencrypt
Label=traefik.http.routers.tick-grafana.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====
User=1000:1000

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
