[Unit]
Description=Telegraf (stack tick)
After=network-online.target tick-influxdb.service
Requires=tick-influxdb.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/telegraf:latest
AutoUpdate=registry
ContainerName=tick-telegraf
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=%h/.config/tick/telegraf.conf:/etc/telegraf/telegraf.conf:ro
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=/sys:/host/sys:ro
Volume=/proc:/host/proc:ro
Volume=/etc:/host/etc:ro

# ==== Networks ====
Network=tick.network
NetworkAlias=telegraf

# ==== Secrets ====
Secret=influxdb_admin_token,type=env,target=DOCKER_INFLUXDB_INIT_ADMIN_TOKEN

# ==== Environment ====
EnvironmentFile=%h/.config/tick/tick.env
EnvironmentFile=%h/.config/tick/tick.env.local
Environment=HOST_PROC=/host/proc
Environment=HOST_SYS=/host/sys
Environment=HOST_ETC=/host/etc

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=pgrep -x telegraf || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====
AddCapability=cap_net_raw
AddCapability=cap_net_bind_service

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
