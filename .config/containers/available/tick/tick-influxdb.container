[Unit]
Description=influxdb
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/influxdb:latest
AutoUpdate=registry
ContainerName=tick-influxdb

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=tick-influxdb.volume:/var/lib/influxdb:Z

# ==== Networks ====
Network=proxy.network
Network=tick.network
NetworkAlias=influxdb

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.tick-influxdb.loadbalancer.server.port=8086
Label=traefik.http.routers.tick-influxdb.rule=Host(`influxdb.${FQDN}`)
Label=traefik.http.routers.tick-influxdb.entrypoints=websecure
Label=traefik.http.routers.tick-influxdb.tls.certresolver=letsencrypt
Label=traefik.http.routers.tick-influxdb.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
