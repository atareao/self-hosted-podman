[Unit]
Description=InfluxDB 2.7 (stack tick)
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/influxdb:2.7
AutoUpdate=registry
ContainerName=tick-influxdb
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=tick-influxdb.volume:/var/lib/influxdb2:Z

# ==== Networks ====
Network=proxy.network
Network=tick.network
NetworkAlias=influxdb

# ==== Secrets ====
Secret=influxdb_admin_password,type=env,target=DOCKER_INFLUXDB_INIT_PASSWORD
Secret=influxdb_admin_token,type=env,target=DOCKER_INFLUXDB_INIT_ADMIN_TOKEN

# ==== Environment ====
EnvironmentFile=%h/.config/tick/tick.env
EnvironmentFile=%h/.config/tick/tick.env.local
Environment=DOCKER_INFLUXDB_INIT_MODE=setup
Environment=DOCKER_INFLUXDB_INIT_RETENTION=30d

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.tick-influxdb.loadbalancer.server.port=8086
Label=traefik.http.routers.tick-influxdb.rule=Host(`influxdb.${FQDN}`)
Label=traefik.http.routers.tick-influxdb.entrypoints=websecure
Label=traefik.http.routers.tick-influxdb.tls.certresolver=letsencrypt
Label=traefik.http.routers.tick-influxdb.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=influx ping --host http://127.0.0.1:8086 || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=60s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
