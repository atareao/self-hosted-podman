[Unit]
Description=nitter
After=network-online.target nitter-redis.service traefik.service
Requires=nitter-redis.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/zedeus/nitter:8142bab1a920d13589ab5e689d7623ac0ac7ec34
ContainerName=nitter

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/nitter/nitter.conf:/src/nitter.conf:ro

# ==== Networks ====
Network=proxy.network
Network=nitter.network
NetworkAlias=nitter

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.nitter.loadbalancer.server.port=8080
Label=traefik.http.routers.nitter.rule=Host(`nitter.${FQDN}`)
Label=traefik.http.routers.nitter.entrypoints=websecure
Label=traefik.http.routers.nitter.tls.certresolver=letsencrypt
Label=traefik.http.routers.nitter.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=wget -nv --tries=1 --spider http://127.0.0.1:8080/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=15s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
