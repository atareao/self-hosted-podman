[Unit]
Description=nitter-redis
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/redis:6-alpine
ContainerName=nitter-redis

# ==== Command ====
Exec=redis-server --save 60 1 --loglevel warning

# ==== Ports ====


# ==== Volumes ====
Volume=nitter-redis.volume:/data:Z

# ==== Networks ====
Network=nitter.network
NetworkAlias=nitter-redis

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=redis-cli ping || exit 1
HealthInterval=30s
HealthRetries=2
HealthTimeout=5s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
