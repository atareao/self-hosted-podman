[Unit]
Description=open-webui
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=ghcr.io/open-webui/open-webui:main
ContainerName=open-webui
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=8080:8080

# ==== Volumes ====
Volume=open-webui-data.volume:/app/backend/data:Z

# ==== Networks ====
Network=open-webui.network
NetworkAlias=open-webui

# ==== Secrets ====


# ==== Environment ====
Environment=OLLAMA_BASE_URL=http://ollama:11434
Environment=WEBUI_SECRET_KEY=

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
