[Unit]
Description=open-webui
After=network-online.target open-webui-ollama.service
Requires=open-webui-ollama.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=ghcr.io/open-webui/open-webui:main
ContainerName=open-webui
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=8080:8080

# ==== Volumes ====
Volume=open-webui-data.volume:/app/backend/data:Z

# ==== Networks ====
Network=open-webui.network
NetworkAlias=open-webui

# ==== Secrets ====
Secret=open_webui_secret_key,type=env,target=WEBUI_SECRET_KEY


# ==== Environment ====
Environment=OLLAMA_BASE_URL=http://ollama:11434

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=curl -fsS http://127.0.0.1:8080/health
HealthInterval=30s
HealthRetries=5
HealthTimeout=10s
HealthStartPeriod=30s


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
