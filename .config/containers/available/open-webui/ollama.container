[Unit]
Description=ollama
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/ollama/ollama
AutoUpdate=registry
ContainerName=ollama
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=11434:11434

# ==== Volumes ====
Volume=open-webui-ollama.volume:/root/.ollama:Z

# ==== Networks ====
Network=open-webui.network
NetworkAlias=ollama

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
