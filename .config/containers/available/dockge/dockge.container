[Unit]
Description=Dockge
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/louislam/dockge
ContainerName=dockge
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=%h/.config/dockge/stacks:/opt/stacks:Z
Volume=%h/.config/dockge/data:/app/data:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====

# ==== Environment ====

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.dockge.loadbalancer.server.port=5001
Label=traefik.http.routers.dockge.rule=Host(`dockge.${FQDN}`)
Label=traefik.http.routers.dockge.entrypoints=websecure
Label=traefik.http.routers.dockge.tls.certresolver=letsencrypt
Label=traefik.http.routers.dockge.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=/app/extra/healthcheck
HealthInterval=60s
HealthTimeout=30s
HealthStartPeriod=60s
HealthRetries=5

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=on-failure
RestartSec=10s
TimeoutStartSec=90
ExecStartPost=/usr/bin/bash -c 'while [ "$(podman inspect --format "{{.State.Health.Status}}" dockge)" != "healthy" ]; do sleep 2; done'

[Install]
WantedBy=default.target