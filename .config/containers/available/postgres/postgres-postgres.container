[Unit]
Description=postgres
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/postgres:17-alpine
ContainerName=postgres-postgres
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=postgres-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=postgres.network
NetworkAlias=postgres

# ==== Secrets ====
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=root
Environment=POSTGRES_DB=test_db

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=pg_isready -U root -d test_db
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=15s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
