[Unit]
Description=postgres
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:latest
AutoUpdate=registry
ContainerName=postgres-postgres

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=postgres-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=postgres.network
NetworkAlias=postgres

# ==== Secrets ====
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====
Environment=POSTGRES_USER=root
Environment=POSTGRES_DB=test_db

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
