[Unit]
Description=pgadmin4
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/dpage/pgadmin4
AutoUpdate=registry
ContainerName=pgadmin4

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=postgres-pgadmin.volume:/var/lib/pgadmin:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====
Environment=PGADMIN_DEFAULT_EMAIL=
Environment=PGADMIN_DEFAULT_PASSWORD=

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.pgadmin.loadbalancer.server.port=80
Label=traefik.http.routers.pgadmin.rule=Host(`pgadmin.{{ env.FQDN }}`)
Label=traefik.http.routers.pgadmin.entrypoints=websecure
Label=traefik.http.routers.pgadmin.tls.certresolver=letsencrypt
Label=traefik.http.routers.pgadmin.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
