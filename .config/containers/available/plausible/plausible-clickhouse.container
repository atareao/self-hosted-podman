[Unit]
Description=plausible-clickhouse
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/yandex/clickhouse-server:21.3.2.5
ContainerName=plausible-clickhouse

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=plausible-event-data.volume:/var/lib/clickhouse:Z
Volume=%h/.config/plausible/clickhouse/clickhouse-config.xml:/etc/clickhouse-server/config.d/logging.xml:ro
Volume=%h/.config/plausible/clickhouse/clickhouse-user-config.xml:/etc/clickhouse-server/users.d/logging.xml:ro

# ==== Networks ====
Network=plausible.network
NetworkAlias=plausible_events_db

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
