[Unit]
Description=plausible_db
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/postgres:12
ContainerName=plausible_db

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=plausible-db-data.volume:/var/lib/postgresql/data:Z

# ==== Networks ====
Network=plausible.network

# ==== Secrets ====
Secret=plausible_postgres_password,type=env,target=POSTGRES_PASSWORD

# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
