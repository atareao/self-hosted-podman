[Unit]
Description=stirlingpdf
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/stirlingtools/stirling-pdf:latest
AutoUpdate=registry
ContainerName=stirlingpdf
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=stirling-pdf-trainingData.volume:/usr/share/tessdata:Z
Volume=stirling-pdf-extraConfigs.volume:/configs:Z
Volume=stirling-pdf-customFiles.volume:/customFiles/:Z
Volume=stirling-pdf-logs.volume:/logs/:Z
Volume=stirling-pdf-pipeline.volume:/pipeline/:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=stirlingpdf

# ==== Secrets ====


# ==== Environment ====
Environment=DOCKER_ENABLE_SECURITY=False
Environment=LANGS=es_ES

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.stirlingpdf.loadbalancer.server.port=8080
Label=traefik.http.routers.stirlingpdf.rule=Host(`stirling-pdf.${FQDN}`)
Label=traefik.http.routers.stirlingpdf.entrypoints=websecure
Label=traefik.http.routers.stirlingpdf.tls.certresolver=letsencrypt
Label=traefik.http.routers.stirlingpdf.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
