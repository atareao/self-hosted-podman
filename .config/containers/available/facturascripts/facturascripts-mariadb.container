[Unit]
Description=facturascripts-mariadb
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mariadb
ContainerName=facturascripts-mariadb
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=facturascripts-mariadb.volume:/var/lib/mysql:U

# ==== Networks ====
Network=facturascripts.network
NetworkAlias=mariadb

# ==== Secrets ====
Secret=facturascripts_mariadb_root_password,type=env,target=MARIADB_ROOT_PASSWORD
Secret=facturascripts_mysql_password,type=env,target=MYSQL_PASSWORD

# ==== Environment ====
Environment=MYSQL_DATABASE=facturascripts
Environment=MYSQL_USER=facturascripts

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=mariadb-admin ping --silent -uroot -p$$MARIADB_ROOT_PASSWORD
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
HealthStartPeriod=15s

# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
