[Unit]
Description=mariadb
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mariadb
AutoUpdate=registry
ContainerName=facturascripts-mariadb

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/facturascripts/mariadb:/var/lib/mysql:Z

# ==== Networks ====
Network=facturascripts.network
NetworkAlias=mariadb

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
