[Unit]
Description=facturascripts
After=network-online.target facturascripts-mariadb.service traefik.service
Requires=facturascripts-mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/facturascripts/facturascripts:latest
ContainerName=facturascripts
AutoUpdate=registry

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=facturascripts-data.volume:/var/www/html:U

# ==== Networks ====
Network=proxy.network
Network=facturascripts.network
NetworkAlias=facturascripts

# ==== Secrets ====
Secret=facturascripts_db_password,type=env,target=FS_DB_PASS
Secret=facturascripts_initial_password,type=env,target=FS_INITIAL_PASS

# ==== Environment ====
Environment=FS_DB_TYPE=mysql
Environment=FS_DB_HOST=mariadb
Environment=FS_DB_PORT=3306
Environment=FS_DB_NAME=facturascripts
Environment=FS_DB_USER=facturascripts
Environment=FS_INITIAL_USER=admin
Environment=FS_LANG=es_ES

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.facturascripts.loadbalancer.server.port=80
Label=traefik.http.routers.facturascripts.rule=Host(`fs.${FQDN}`)
Label=traefik.http.routers.facturascripts.entrypoints=websecure
Label=traefik.http.routers.facturascripts.tls.certresolver=letsencrypt
Label=traefik.http.routers.facturascripts.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
