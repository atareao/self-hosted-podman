[Unit]
Description=facturascripts
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/facturascripts/facturascripts:latest
AutoUpdate=registry
ContainerName=facturascripts

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/facturascripts/facturascripts:/var/www/html:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=facturascripts

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.facturascripts.loadbalancer.server.port=80
Label=traefik.http.routers.facturascripts.rule=Host(`fs.${FQDN}`)
Label=traefik.http.routers.facturascripts.entrypoints=websecure
Label=traefik.http.routers.facturascripts.tls.certresolver=letsencrypt
Label=traefik.http.routers.facturascripts.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
