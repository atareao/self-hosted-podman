[Unit]
Description=opengist
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=ghcr.io/thomiceli/opengist:latest
AutoUpdate=registry
ContainerName=opengist
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=opengist-data.volume:/opengist:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=opengist

# ==== Secrets ====
Secret=opengist_og_gitea_client_key,type=env,target=OG_GITEA_CLIENT_KEY
Secret=opengist_og_gitea_secret,type=env,target=OG_GITEA_SECRET

# ==== Environment ====
Environment=UID=1000
Environment=GID=1000
Environment=OG_GITEA_URL="https://gitea.${FQDN}"

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.gist.loadbalancer.server.port=6157
Label=traefik.http.routers.gist.rule=Host(`gist.${FQDN}`)
Label=traefik.http.routers.gist.entrypoints=websecure
Label=traefik.http.routers.gist.tls.certresolver=letsencrypt
Label=traefik.http.routers.gist.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
