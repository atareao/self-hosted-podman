[Unit]
Description=whisper
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/onerahmet/openai-whisper-asr-webservice:latest-gpu
AutoUpdate=registry
ContainerName=whisper
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=9000:9000

# ==== Volumes ====
Volume=whisper-data.volume:/data/whisper:Z

# ==== Networks ====


# ==== Secrets ====


# ==== Environment ====
Environment=ASR_MODEL=large-v1
Environment=ASR_ENGINE=faster_whisper
Environment=ASR_MODEL_PATH=/data/whisper

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
