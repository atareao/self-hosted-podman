[Unit]
Description=whisper
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
# CPU: la maquina no tiene GPU NVIDIA; :latest-gpu exigiria el runtime NVIDIA.
Image=docker.io/onerahmet/openai-whisper-asr-webservice:latest
AutoUpdate=registry
ContainerName=whisper
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
# Host 9001: el 9000 lo publica authentik en 0.0.0.0:9000:9000.
PublishPort=9001:9000

# ==== Volumes ====
Volume=whisper-data.volume:/data/whisper:Z

# ==== Networks ====


# ==== Secrets ====


# ==== Environment ====
# Modelo pequeno para verificacion: large-v1 descargaba varios GB en el 1er arranque.
Environment=ASR_MODEL=small
Environment=ASR_ENGINE=faster_whisper
Environment=ASR_MODEL_PATH=/data/whisper

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
