[Unit]
Description=element_web
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/vectorim/element-web
AutoUpdate=registry
ContainerName=element_web

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=proxy.network
NetworkAlias=element

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.element.loadbalancer.server.port=80
Label=traefik.http.routers.element.rule=Host(`matrix.{{ env.FQDN }}`)
Label=traefik.http.routers.element.entrypoints=websecure
Label=traefik.http.routers.element.tls.certresolver=letsencrypt
Label=traefik.http.routers.element.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
