[Unit]
Description=Headscale (Tailscale control server, rootless)
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/headscale/headscale:latest
ContainerName=headscale
AutoUpdate=registry
PodmanArgs=--init

# ==== Command ====
Exec=serve

# ==== Ports ====
# STUN del DERP embebido. El resto del trafico entra por Traefik.
PublishPort=3478:3478/udp

# ==== Volumes ====
Volume=%h/.config/headscale/config.yaml:/etc/headscale/config.yaml:ro,Z
Volume=headscale-data.volume:/var/lib/headscale:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=headscale

# ==== Secrets ====

# ==== Environment ====
EnvironmentFile=%h/.config/headscale/headscale.env
EnvironmentFile=%h/.config/headscale/headscale.env.local

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.headscale.loadbalancer.server.port=8080
Label=traefik.http.routers.headscale.rule=Host(`headscale.${FQDN}`)
Label=traefik.http.routers.headscale.entrypoints=websecure
Label=traefik.http.routers.headscale.tls.certresolver=letsencrypt
Label=traefik.http.routers.headscale.tls.options=headscale-http1@file
Label=traefik.http.routers.headscale.middlewares=seguridadHeaders@file,compresionHeaders@file,headplane-cors
Label=me.tale.headplane.target=headscale
Label=traefik.http.middlewares.headplane-cors.headers.accesscontrolallowheaders=*
Label=traefik.http.middlewares.headplane-cors.headers.accesscontrolallowmethods=GET,POST,PUT
Label=traefik.http.middlewares.headplane-cors.headers.accesscontrolalloworiginlist=https://headscale.${FQDN}
Label=traefik.http.middlewares.headplane-cors.headers.accesscontrolmaxage=100
Label=traefik.http.middlewares.headplane-cors.headers.addvaryheader=true

# ==== Healthcheck ====
HealthCmd=["/ko-app/headscale","health"]
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====
NoNewPrivileges=true
SecurityLabelDisable=true

# ==== Resources ====
Memory=256M

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=180

[Install]
WantedBy=default.target
