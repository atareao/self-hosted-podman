[Unit]
Description=mysteryshack
After=network-online.target traefik.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/atareao/mysteryshack:v1.0
ContainerName=mysteryshack
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/mysteryshack/data:/rs/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=mysteryshack

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.mysteryshack.loadbalancer.server.port=6767
Label=traefik.http.routers.mysteryshack.rule=Host(`mysteryshack.${FQDN}`)
Label=traefik.http.routers.mysteryshack.entrypoints=websecure
Label=traefik.http.routers.mysteryshack.tls.certresolver=letsencrypt
Label=traefik.http.routers.mysteryshack.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=wget -q --spider http://127.0.0.1:6767/
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
