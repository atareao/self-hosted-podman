[Unit]
Description=cells-mysql
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mysql:8
ContainerName=cells-mysql
PodmanArgs=--init

# ==== Command ====
Exec=mysqld --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci

# ==== Ports ====


# ==== Volumes ====
Volume=cells-mysql.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=cells.network
NetworkAlias=mysql

# ==== Secrets ====
Secret=cells_mysql_root_password,type=env,target=MYSQL_ROOT_PASSWORD
Secret=cells_mysql_password,type=env,target=MYSQL_PASSWORD

# ==== Environment ====
EnvironmentFile=%h/.config/cells/cells.env
EnvironmentFile=%h/.config/cells/cells.env.local

# ==== Labels ====


# ==== Healthcheck ====
HealthCmd=mysqladmin ping -h 127.0.0.1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
