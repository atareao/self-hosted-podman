[Unit]
Description=cells-mysql
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/mysql:8
ContainerName=cells-mysql
PodmanArgs=--init

# ==== Command ====
Exec=mysqld --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci

# ==== Ports ====


# ==== Volumes ====
Volume=cells-mysql.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=cells.network
NetworkAlias=mysql

# ==== Secrets ====
Secret=cells_mysql_root_password,type=env,target=MYSQL_ROOT_PASSWORD
Secret=cells_mysql_password,type=env,target=MYSQL_PASSWORD

# ==== Environment ====
Environment=MYSQL_DATABASE=$MYSQL_DATABASE
Environment=MYSQL_USER=$MYSQL_USER

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
