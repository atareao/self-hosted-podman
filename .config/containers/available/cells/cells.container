[Unit]
Description=cells
After=network-online.target traefik.service cells-mysql.service
Requires=cells-mysql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/pydio/cells:latest
AutoUpdate=registry
ContainerName=cells
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=cells-app.volume:/var/cells:Z
Volume=cells-data.volume:/var/cells/data:Z

# ==== Networks ====
Network=proxy.network
Network=cells.network
NetworkAlias=cells

# ==== Secrets ====


# ==== Environment ====
EnvironmentFile=%h/.config/cells/cells.env
EnvironmentFile=%h/.config/cells/cells.env.local
Environment=CELLS_SITE_NO_TLS=1
Environment=CELLS_SITE_EXTERNAL="https://cells.${FQDN}"

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.cells.loadbalancer.server.port=8080
Label=traefik.http.routers.cells.rule=Host(`cells.${FQDN}`)
Label=traefik.http.routers.cells.entrypoints=websecure
Label=traefik.http.routers.cells.tls.certresolver=letsencrypt
Label=traefik.http.routers.cells.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====
HealthCmd=wget -q --spider http://127.0.0.1:8080/
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
