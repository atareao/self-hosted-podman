[Unit]
Description=huginn-threaded
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/huginn/huginn-single-process
AutoUpdate=registry
ContainerName=huginn-threaded
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====


# ==== Networks ====
Network=huginn.network
NetworkAlias=threaded

# ==== Secrets ====
Secret=huginn_database_password,type=env,target=DATABASE_PASSWORD

# ==== Environment ====
Environment=DATABASE_NAME=huginn
Environment=DATABASE_USERNAME=huginn
Environment=WORKER_CMD=bin/threaded.rb

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
