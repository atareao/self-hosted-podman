[Unit]
Description=semaphore
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/semaphoreui/semaphore:latest
AutoUpdate=registry
ContainerName=semaphore
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=semaphore-config.volume:/etc/semaphore:Z
Volume=semaphore-data.volume:/var/lib/semaphore:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====
Environment=SEMAPHORE_DB_DIALECT=
Environment=SEMAPHORE_ADMIN_PASSWORD=
Environment=SEMAPHORE_ADMIN_NAME=
Environment=SEMAPHORE_ADMIN_EMAIL=
Environment=SEMAPHORE_ADMIN=

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.semaphore.loadbalancer.server.port=5005
Label=traefik.http.routers.semaphore.rule=Host(`semaphore.{{ env.FQDN }}`)
Label=traefik.http.routers.semaphore.entrypoints=websecure
Label=traefik.http.routers.semaphore.tls.certresolver=letsencrypt
Label=traefik.http.routers.semaphore.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
