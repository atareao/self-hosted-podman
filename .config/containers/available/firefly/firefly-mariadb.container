[Unit]
Description=firefly-mariadb
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mariadb:11
ContainerName=firefly-mariadb

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=firefly-mariadb.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=firefly.network
NetworkAlias=db_for_firefly

# ==== Secrets ====
Secret=firefly_mariadb_root_password,type=env,target=MARIADB_ROOT_PASSWORD
Secret=firefly_db_password,type=env,target=MARIADB_PASSWORD

# ==== Environment ====
Environment=MARIADB_DATABASE=firefly
Environment=MARIADB_USER=firefly

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=mariadb-admin ping --user=root --password="$MARIADB_ROOT_PASSWORD" --silent
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
