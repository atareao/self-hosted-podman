[Unit]
Description=db_for_firefly
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/yobasystems/alpine-mariadb:latest
AutoUpdate=registry
ContainerName=db_for_firefly

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/firefly/firefly_db:/var/lib/mysql:Z

# ==== Networks ====
Network=firefly.network

# ==== Secrets ====
Secret=firefly_mysql_random_root_password,type=env,target=MYSQL_RANDOM_ROOT_PASSWORD
Secret=firefly_mysql_password,type=env,target=MYSQL_PASSWORD

# ==== Environment ====
Environment=MYSQL_USER=firefly
Environment=MYSQL_DATABASE=firefly

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
