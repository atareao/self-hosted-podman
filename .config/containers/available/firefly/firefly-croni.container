[Unit]
Description=croni
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/atareao/croni:v1.1
ContainerName=firefly-croni

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=%h/.config/firefly/crontab:/crontab:Z

# ==== Networks ====
Network=firefly.network
NetworkAlias=croni_for_firefly

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
