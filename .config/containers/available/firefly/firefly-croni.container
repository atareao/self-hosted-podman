[Unit]
Description=croni
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/atareao/croni:v1.1
ContainerName=firefly-croni

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=%h/.config/firefly/crontab:/crontab.txt:ro,Z

# ==== Networks ====
Network=firefly.network
NetworkAlias=croni_for_firefly

# ==== Secrets ====

# ==== Environment ====
Environment=LOGLEVEL=info

# ==== Labels ====

# ==== Healthcheck ====

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
