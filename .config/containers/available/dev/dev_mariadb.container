[Unit]
Description=dev_mariadb
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/mariadb
AutoUpdate=registry
ContainerName=dev_mariadb
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=dev-dev_mariadb.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=dev.network
NetworkAlias=mariadb

# ==== Secrets ====
Secret=dev_mysql_password,type=env,target=MYSQL_PASSWORD
Secret=dev_mariadb_root_password,type=env,target=MARIADB_ROOT_PASSWORD

# ==== Environment ====
Environment=MYSQL_DATABASE=dev
Environment=MYSQL_USER=dev

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
