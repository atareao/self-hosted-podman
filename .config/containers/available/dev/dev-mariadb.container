[Unit]
Description=dev-mariadb
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/mariadb:11
ContainerName=dev-mariadb
PodmanArgs=--init

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=dev-mariadb.volume:/var/lib/mysql:Z

# ==== Networks ====
Network=dev.network
NetworkAlias=mariadb

# ==== Secrets ====
Secret=dev_mariadb_root_password,type=env,target=MARIADB_ROOT_PASSWORD
Secret=dev_wordpress_db_password,type=env,target=MARIADB_PASSWORD

# ==== Environment ====
Environment=MARIADB_DATABASE=dev
Environment=MARIADB_USER=dev

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=mariadb-admin ping --user=root --password="$MARIADB_ROOT_PASSWORD" --silent
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=30s

# ==== Hardening ====

# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
