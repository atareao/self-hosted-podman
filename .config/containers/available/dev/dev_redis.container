[Unit]
Description=dev_redis
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/library/redis:6
ContainerName=dev_redis
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=dev-dev_redis.volume:/data:Z

# ==== Networks ====
Network=dev.network
NetworkAlias=redis

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
