[Unit]
Description=influxdb
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/library/influxdb:1.8
ContainerName=grafana-influx-telegraf-influxdb
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=grafana-influx-telegraf-influxdb.volume:/var/lib/influxdb:Z

# ==== Networks ====
Network=grafana-influx-telegraf.network
NetworkAlias=influxdb

# ==== Secrets ====
Secret=grafana_influx_telegraf_gf_security_admin_password,type=env,target=GF_SECURITY_ADMIN_PASSWORD

# ==== Environment ====
Environment=GF_INSTALL_PLUGINS=grafana-clock-panel,briangann-gauge-panel,natel-plotly-panel,grafana-simple-json-datasource
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_USERS_ALLOW_SIGN_UP=FALSE

# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
