[Unit]
Description=dufs
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/sigoden/dufs
AutoUpdate=registry
ContainerName=dufs
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=dufs-data.volume:/data:Z

# ==== Networks ====
Network=proxy.network
NetworkAlias=dufs

# ==== Secrets ====


# ==== Environment ====
Environment=DUFS_SERVE_PATH=/data
Environment=DUFS_HIDDEN=tmp,*.log,*.lock
Environment=DUFS_AUTH=$DUFS_AUTH
Environment=DUFS_ALLOW_ALL=True
Environment=DUFS_ALLOW_UPLOAD=True
Environment=DUFS_ALLOW_DELETE=True
Environment=DUFS_ALLOW_SEARCH=True
Environment=DUFS_ALLOW_SYMLINK=True
Environment=DUFS_ALLOW_ARCHIVE=True

# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.dufs.loadbalancer.server.port=5000
Label=traefik.http.routers.dufs.rule=Host(`dufs.${FQDN}`)
Label=traefik.http.routers.dufs.entrypoints=websecure
Label=traefik.http.routers.dufs.tls.certresolver=letsencrypt
Label=traefik.http.routers.dufs.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
