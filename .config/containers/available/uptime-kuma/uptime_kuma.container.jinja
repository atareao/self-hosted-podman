[Unit]
Description=uptime_kuma
After=network-online.target traefik.service

[Container]
# ==== Image ====
Image=docker.io/louislam/uptime-kuma:2
ContainerName=uptime_kuma
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====


# ==== Volumes ====
Volume=uptime-kuma-data.volume:/app/data:Z

# ==== Networks ====
Network=proxy.network

# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====
Label=traefik.enable=true
Label=traefik.http.services.uptime_kuma.loadbalancer.server.port=3001
Label=traefik.http.routers.uptime_kuma.rule=Host(`uptime.{{ env.FQDN }}`)
Label=traefik.http.routers.uptime_kuma.entrypoints=websecure
Label=traefik.http.routers.uptime_kuma.tls.certresolver=letsencrypt
Label=traefik.http.routers.uptime_kuma.middlewares=seguridadHeaders@file,compresionHeaders@file

# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
