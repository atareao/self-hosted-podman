[Unit]
Description=unbound
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/mvance/unbound:latest
AutoUpdate=registry
ContainerName=unbound
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
PublishPort=53:53/tcp
PublishPort=53:53/udp

# ==== Volumes ====
Volume=%h/.config/unbound/unbound.conf:/opt/unbound/etc/unbound/unbound.conf:Z
Volume=%h/.config/unbound/conf:/opt/unbound/etc/unbound/unbound.conf.d/:Z

# ==== Networks ====


# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
