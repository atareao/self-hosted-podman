[Unit]
Description=unbound
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
# ==== Image ====
Image=docker.io/mvance/unbound:latest
AutoUpdate=registry
ContainerName=unbound
PodmanArgs=--init

# ==== Command ====


# ==== Ports ====
# Podman rootless (net.ipv4.ip_unprivileged_port_start=80) no puede enlazar el 53
# en el host: se publica en 5353 conservando el 53 interno del contenedor.
PublishPort=5353:53/tcp
PublishPort=5353:53/udp

# ==== Volumes ====
# La imagen genera su propio unbound.conf y solo incluye a-records.conf,
# srv-records.conf y forward-records.conf (NO unbound.conf.d/). Montamos el
# fragmento versionado sobre forward-records.conf: es el punto de extensión
# que documenta la imagen (y al comentar la forward-zone deja de reenviar a
# Cloudflare y resuelve por recursión). NO se monta nada sobre unbound.conf,
# que sigue siendo el de la imagen.
Volume=%h/.config/unbound/conf/forward-records.conf:/opt/unbound/etc/unbound/forward-records.conf:ro,Z

# ==== Networks ====


# ==== Secrets ====


# ==== Environment ====


# ==== Labels ====


# ==== Healthcheck ====


# ==== Hardening ====


# ==== Resources ====

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
