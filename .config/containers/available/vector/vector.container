[Unit]
Description=Vector Log Router (Rust-based)
After=network-online.target

[Container]
# ==== Image ====
Image=docker.io/timberio/vector:latest-alpine
ContainerName=vector
AutoUpdate=registry

# ==== Command ====

# ==== Ports ====

# ==== Volumes ====
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=/var/log/journal:/var/log/journal:ro
Volume=/run/log/journal:/run/log/journal:ro
Volume=%h/.config/vector/vector.yaml:/etc/vector/vector.yaml:ro,Z
Volume=vector-data.volume:/var/lib/vector:Z

# ==== Networks ====
Network=security.network

# ==== Secrets ====
# Mismo secret que openobserve (garantiza que el login coincide).
Secret=openobserve_root_password,type=env,target=OO_USER_PASSWORD
# TODO: CrowdSec aún no define ingest; cuando exista, descomentar y crear el secret:
# Secret=crowdsec_ingest_password,type=env,target=VECTOR_INGEST_PASSWORD

# ==== Environment ====
Environment=VECTOR_SELF_DATA_DIR=/var/lib/vector
EnvironmentFile=%h/.config/vector/vector.env
EnvironmentFile=%h/.config/vector/vector.env.local

# ==== Labels ====

# ==== Healthcheck ====
HealthCmd=vector validate --config-yaml /etc/vector/vector.yaml || exit 1
HealthInterval=90s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=15s

# ==== Hardening ====
AddCapability=CAP_DAC_READ_SEARCH

# ==== Resources ====

[Service]
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60
ExecStartPre=/usr/bin/sleep 2
ExecStartPost=/usr/bin/bash -c 'while [ "$(podman inspect --format "{{.State.Health.Status}}" vector) != "healthy" ]; do sleep 2; done'

[Install]
WantedBy=default.target