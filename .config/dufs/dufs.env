# Config no secreta de la stack dufs (versionada).
# Overrides por maquina en dufs.env.local (gitignored; lo crea el hook post_pull).
# La credencial DUFS_AUTH va por podman secret (Secret=dufs_auth).
DUFS_SERVE_PATH=/data
DUFS_HIDDEN=tmp,*.log,*.lock
DUFS_ALLOW_ALL=True
DUFS_ALLOW_UPLOAD=True
DUFS_ALLOW_DELETE=True
DUFS_ALLOW_SEARCH=True
DUFS_ALLOW_SYMLINK=True
DUFS_ALLOW_ARCHIVE=True
