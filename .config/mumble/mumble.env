# Config NO secreta de la stack mumble (versionada).
# Overrides por maquina en mumble.env.local (gitignored; lo crea el hook post_pull).
#
# SERVER es el host al que se conecta mumble-recorder. `mumble` es el
# NetworkAlias del servidor dentro de mumble.network, asi que resuelve sin
# salir del stack (la imagen del recorder espera SERVER, no SERVER_IP).
SERVER=mumble
