# Config no secreta de la stack apimail (versionada).
# Overrides por maquina en apimail.env.local (gitignored; lo crea el hook post_pull).
# Los secretos (APIMAIL_API_KEY, APIMAIL_IMAP_PASSWORD, APIMAIL_SMTP_PASSWORD) van por podman secret.
APIMAIL_HOST=0.0.0.0
APIMAIL_PORT=3000
# Cuenta IMAP (host y usuario obligatorios; ajusta los reales en apimail.env.local)
APIMAIL_IMAP_HOST=imap.example.com
APIMAIL_IMAP_USER=user@example.com
# Puerto IMAP: vacio -> derivado del modo TLS (993 implicit / 143 starttls)
# APIMAIL_IMAP_PORT=
APIMAIL_IMAP_TLS=implicit
APIMAIL_IMAP_TIMEOUT_SECS=30
# Cuenta SMTP (host y usuario obligatorios; ajusta los reales en apimail.env.local)
APIMAIL_SMTP_HOST=smtp.example.com
APIMAIL_SMTP_USER=user@example.com
# Puerto SMTP: vacio -> derivado del modo TLS (465 implicit / 587 starttls)
# APIMAIL_SMTP_PORT=
APIMAIL_SMTP_TLS=implicit
# Limites de parseo (bytes)
APIMAIL_MAX_ATTACHMENT_BYTES=10485760
APIMAIL_MAX_MESSAGE_BYTES=26214400
# IDLE y webhook (sin APIMAIL_WEBHOOK_URL la suscripcion IDLE no arranca)
# APIMAIL_WEBHOOK_URL=
APIMAIL_IDLE_MAILBOX=INBOX
APIMAIL_WEBHOOK_TIMEOUT_SECS=10
# Cola durable del webhook (sobrevive a recrear el contenedor)
APIMAIL_QUEUE_PATH=/app/data/queue.jsonl
APIMAIL_QUEUE_MAX_ITEMS=1000
APIMAIL_QUEUE_MAX_BYTES=67108864
