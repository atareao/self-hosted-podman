# Config no secreta de la stack watchbeat (versionada).
# Overrides por maquina en watchbeat.env.local (gitignored; lo crea el hook post_pull).
# El client secret OIDC (OIDC_CLIENT_SECRET) va por podman secret.
# OIDC_REDIRECT_URL se fija en el quadlet (https://${FQDN}/auth/callback).
HOST=0.0.0.0
PORT=3055
DATA_DIR=/app/data
DATABASE_URL=/app/data/watchbeat.db
TIMEZONE=Europe/Madrid
RUST_LOG=info
LOG_FORMAT=pretty
# Retencion de checks antiguos (dias)
WATCHBEAT_RETENTION_DAYS=30
# OIDC (ajusta los valores reales en watchbeat.env.local)
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=watchbeat
