# Config no secreta de la stack watchbeat (versionada).
# Overrides por maquina en watchbeat.env.local (gitignored; lo crea el hook post_pull).
# El client secret OIDC (OIDC_CLIENT_SECRET) va por podman secret.
# OIDC_ISSUER_URL (https://auth.${FQDN}, el PocketID) y OIDC_REDIRECT_URL
# (https://watchbeat.${FQDN}/auth/callback) se fijan en el quadlet: systemd
# expande ${FQDN} en el ExecStart, pero EnvironmentFile NO expande variables,
# asi que aqui solo pueden ir valores literales (o el override en .env.local).
HOST=0.0.0.0
PORT=3055
DATA_DIR=/app/data
DATABASE_URL=/app/data/watchbeat.db
TIMEZONE=Europe/Madrid
RUST_LOG=info
LOG_FORMAT=pretty
# Retencion de checks antiguos (dias)
WATCHBEAT_RETENTION_DAYS=30
# OIDC_CLIENT_ID: client ID registrado en PocketID (issuer https://auth.${FQDN}).
OIDC_CLIENT_ID=watchbeat
