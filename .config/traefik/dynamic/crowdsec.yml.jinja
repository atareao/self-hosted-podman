http:
  middlewares:
    crowdsec-bouncer:
      plugin:
        crowdsec:
          enabled: true
          crowdsecLapiScheme: http
          crowdsecLapiHost: "crowdsec:8080"
          crowdsecLapiKey: {{ env.CROWDSEC_BOUNCER_KEY }}
          remediationStrategy: ban
          updateIntervalSeconds: 60
