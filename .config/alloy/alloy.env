# Config no secreta de la stack alloy (versionada).
# Overrides por maquina en alloy.env.local (gitignored; lo crea el hook post_pull).
# OIDC_ISSUER_URL y OIDC_CLIENT_ID son especificos del despliegue: ajustalos aqui o en alloy.env.local.
TIMEZONE=Europe/Madrid
DOCKER_HOST=unix:///var/run/docker.sock
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=alloy
