# Config no secreta de la stack zennotes (versionada).
# Overrides por maquina en zennotes.env.local (gitignored; lo crea el hook post_pull).
# El token de acceso (ZENNOTES_AUTH_TOKEN) va por podman secret.
ZENNOTES_VAULT_PATH=/workspace
ZENNOTES_CONFIG_PATH=/data/server.json
ZENNOTES_BEHIND_TLS=1
ZENNOTES_PERSIST_SESSIONS=1
