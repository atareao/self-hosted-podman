[Unit]
Description=geoipupdate for authentik
After=network.target

[Container]
# ==== Image ====
Image=maxmindinc/geoipupdate:latest
ContainerName=geoipupdate
AutoUpdate=registry
PodmanArgs=--init
# ==== Command ==== 
# ==== Ports ==== 
# ==== Volumes ==== 
Volume=geoip:/usr/share/GeoIP
# ==== Networks ==== 
Network=authentik
# ==== Secrets ==== 
# ==== Environment ==== 
Environment=GEOIPUPDATE_EDITION_IDS=GeoLite2-City
Environment=GEOIPUPDATE_FREQUENCY=8
# ==== Labels ==== 
# ==== Healthcheck ==== 
# Traefik optional not needed
# ==== Hardening ==== 
# ==== Resources ==== 

[Service]
Environment=SOPS_AGE_KEY_FILE=%h/.secrets/sops/age/key.txt
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
